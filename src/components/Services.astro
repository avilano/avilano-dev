---
---
<section id="services" class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-mono uppercase tracking-wider text-brand-400 font-semibold mb-2">Predictable Pricing • Zero Scope Creep</h2>
      <h3 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Transparent Engineering Sprints & Retainers
      </h3>
      <p class="mt-4 text-slate-300 text-base sm:text-lg">
        No ambiguous hourly billing or bloated agency contracts. Pay for fixed outcomes or an async monthly subscription that you can pause or cancel anytime.
      </p>
    </div>

    <!-- The 2 Big Tracks: Sprints vs Retainer -->
    <div class="space-y-12">

      <!-- Track 1: The Monthly Subscription (Model 1 Featured) -->
      <div class="p-8 md:p-10 rounded-3xl bg-gradient-to-b from-dark-800 to-dark-900 border-2 border-brand-500/40 shadow-2xl shadow-brand-500/10 relative overflow-hidden">
        <div class="absolute -top-3 right-8 px-4 py-1 rounded-full bg-gradient-to-r from-brand-500 to-indigo-600 text-white font-mono text-xs font-bold uppercase tracking-wider shadow-lg">
          Most Popular • Limited to 3 Clients
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <span class="inline-block px-3 py-1 rounded-lg bg-brand-500/10 text-brand-400 font-mono text-xs font-semibold mb-3">Model 1: The Async Subscription</span>
            <h4 class="text-2xl sm:text-3xl font-extrabold text-white">Fractional AI QA & Accessibility Partner</h4>
            <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
              Get an embedded Senior AI QA Architect on your team. Submit unlimited testing, flaky-test fixes, AI workflow prompts, and WCAG accessibility tickets into a shared Linear queue.
            </p>

            <ul class="mt-6 space-y-3 text-sm text-slate-300">
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                <span><strong>1 active request at a time</strong> (24–48 hour turnaround on average)</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                <span>Continuous E2E, API & WCAG compliance testing on every new Pull Request</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                <span>Maintaining custom AI agent rules (Cursor / Claude) & self-healing test patterns</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                <span><strong>Pause or cancel anytime via Stripe</strong> with 1 click</span>
              </li>
            </ul>
          </div>

          <div class="lg:col-span-5 bg-dark-900/90 p-6 sm:p-8 rounded-2xl border border-dark-700 flex flex-col justify-between">
            <div>
              <div class="flex items-baseline gap-2">
                <span class="text-4xl sm:text-5xl font-black text-white">$5,495</span>
                <span class="text-slate-400 font-medium text-base">/ month</span>
              </div>
              <p class="text-xs text-brand-400 font-mono mt-1">Pilot rate: $4,495/mo for first 2 clients</p>
              <p class="text-xs text-slate-400 mt-4 leading-relaxed">
                Replaces a $195,000 full-time W-2 Senior SDET plus recruiting fees, equity, and benefits. Zero onboarding lag.
              </p>
            </div>

            <div class="mt-8 space-y-3">
              <a
                href="#book-call"
                class="w-full py-3.5 px-6 rounded-xl font-semibold text-center text-white bg-gradient-to-r from-brand-500 to-indigo-600 hover:from-brand-600 hover:to-indigo-700 shadow-lg shadow-brand-500/20 block transition-all"
              >
                Apply for a Retainer Slot
              </a>
              <span class="block text-center text-xs text-slate-400">Direct Slack Connect + Linear workspace access</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Track 2: The Fixed 21-Day Sprints Grid -->
      <div>
        <h4 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
          <span>Fixed-Scope 21-Day Execution Sprints</span>
          <span class="text-xs font-mono font-normal text-slate-400">Guaranteed deliverables • Zero ongoing commitment</span>
        </h4>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

          <!-- Sprint 1 -->
          <div class="p-6 rounded-2xl bg-dark-800/80 border border-dark-700/80 flex flex-col justify-between hover:border-dark-600 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded bg-brand-500/10 text-brand-400 font-mono text-xs font-semibold">21-Day Sprint</span>
                <span class="text-2xl font-bold text-white">$5,500</span>
              </div>
              <h5 class="text-lg font-bold text-white mb-2">AI Playwright Foundation</h5>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                Architecture from scratch: TypeScript Playwright setup, API session authentication (&lt;50ms), and AI agent rules for fast test generation.
              </p>
              <ul class="text-xs text-slate-400 space-y-2 mb-6">
                <li>• Top 15 critical user journeys automated</li>
                <li>• Sharded GitHub Actions CI (&lt;3m run)</li>
                <li>• Custom Cursor / Claude rules included</li>
              </ul>
            </div>
            <a
              href="#book-call"
              class="w-full py-2.5 px-4 rounded-lg text-center text-xs font-semibold text-slate-200 border border-dark-600 bg-dark-900/60 hover:bg-dark-700 hover:text-white transition-all block"
            >
              Book Foundation Sprint
            </a>
          </div>

          <!-- Sprint 2 -->
          <div class="p-6 rounded-2xl bg-dark-800/80 border border-dark-700/80 flex flex-col justify-between hover:border-dark-600 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded bg-indigo-500/10 text-indigo-400 font-mono text-xs font-semibold">21-Day Sprint</span>
                <span class="text-2xl font-bold text-white">$6,500</span>
              </div>
              <h5 class="text-lg font-bold text-white mb-2">Legacy Migration Sprint</h5>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                Migrate legacy Selenium or Cypress suites to Playwright with zero release disruption using our dual-run CI architecture.
              </p>
              <ul class="text-xs text-slate-400 space-y-2 mb-6">
                <li>• 25–35 critical paths converted</li>
                <li>• Brittle XPaths replaced with accessible roles</li>
                <li>• CI runtime slashed by 60%+</li>
              </ul>
            </div>
            <a
              href="#book-call"
              class="w-full py-2.5 px-4 rounded-lg text-center text-xs font-semibold text-slate-200 border border-dark-600 bg-dark-900/60 hover:bg-dark-700 hover:text-white transition-all block"
            >
              Book Migration Sprint
            </a>
          </div>

          <!-- Sprint 3 -->
          <div class="p-6 rounded-2xl bg-dark-800/80 border border-emerald-500/30 flex flex-col justify-between hover:border-emerald-500/50 transition-colors relative">
            <span class="absolute -top-2.5 right-4 px-2 py-0.5 rounded bg-emerald-500 text-dark-900 font-mono text-[10px] font-bold uppercase">Compliance Ready</span>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400 font-mono text-xs font-semibold">21-Day Sprint</span>
                <span class="text-2xl font-bold text-white">$7,500</span>
              </div>
              <h5 class="text-lg font-bold text-white mb-2">WCAG 2.1 AA Compliance</h5>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                Complete frontend code remediation (semantic DOM, ARIA, focus traps) + automated @axe-core and VoiceOver CI regression gates.
              </p>
              <ul class="text-xs text-slate-400 space-y-2 mb-6">
                <li>• US ADA Title II & HHS 504 aligned</li>
                <li>• Keyboard trap testing & focus restoration</li>
                <li>• Technical VPAT 2.5 readiness audit</li>
              </ul>
            </div>
            <a
              href="#book-call"
              class="w-full py-2.5 px-4 rounded-lg text-center text-xs font-semibold text-emerald-400 border border-emerald-500/40 bg-emerald-500/10 hover:bg-emerald-500/20 transition-all block"
            >
              Book Compliance Sprint
            </a>
          </div>

        </div>
      </div>

      <!-- Track 3: The Low-Risk Diagnostic Wedge -->
      <div class="p-6 sm:p-8 rounded-2xl bg-dark-900/90 border border-dark-700 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="px-2.5 py-1 rounded bg-brand-500/10 text-brand-400 font-mono text-xs font-semibold">Low-Risk Diagnostic</span>
          <h5 class="text-xl font-bold text-white mt-1">48-Hour Test Velocity & WCAG Risk Audit</h5>
          <p class="text-sm text-slate-300 mt-1 max-w-2xl leading-relaxed">
            Not ready for a full sprint? I will inspect your repository and deliver a 20-minute Loom diagnostic covering flaky selectors, CI bottlenecks, and WCAG AA violation hotspots + a 30-day action plan.
          </p>
          <p class="text-xs text-emerald-400 font-medium mt-2">✨ 100% credited toward any 21-day sprint if you decide to execute with us.</p>
        </div>
        <div class="flex items-center gap-4 flex-shrink-0">
          <div class="text-right">
            <span class="text-2xl font-bold text-white">$950</span>
            <span class="block text-xs text-slate-400">Fixed Fee</span>
          </div>
          <a
            href="#book-call"
            class="px-5 py-3 rounded-xl font-semibold text-xs sm:text-sm bg-white text-dark-900 hover:bg-slate-100 transition-colors whitespace-nowrap shadow-md"
          >
            Order 48-Hr Audit
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
