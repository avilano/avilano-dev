---
---
<section id="services" class="py-20 md:py-28 scroll-reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="text-left max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 font-mono text-xs text-brand-400 font-semibold mb-2 uppercase tracking-wider">
        <span>Transparent Packaging • Zero Scope Creep</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Sprints & Async Retainers
      </h2>
      <p class="mt-4 text-slate-300 text-base sm:text-lg leading-relaxed">
        No ambiguous hourly billing or 6-month agency contracts. Partner on a fixed-outcome sprint or subscribe to a dedicated async engineering queue you can pause or cancel anytime.
      </p>
    </div>

    <!-- The Flagship Retainer (Model 1) -->
    <div class="rounded-2xl border border-dark-700 bg-dark-900/90 shadow-2xl p-8 sm:p-10 mb-14 relative overflow-hidden interactive-card">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Left details -->
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 rounded bg-brand-500/10 text-brand-400 font-mono text-xs font-semibold uppercase">Monthly Retainer</span>
            <span class="text-xs font-mono text-emerald-400">● 1 Slot Open for This Month</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
            Fractional AI QA & Accessibility Partner
          </h3>
          
          <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
            A dedicated Senior SDET & AI Quality Engineer embedded directly in your workflow. Submit unlimited test automation, flaky-test fixes, AI agent workflows, and WCAG accessibility tickets into a shared Linear queue.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mt-6 text-xs sm:text-sm text-slate-300">
            <div class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>1 active task at a time</strong> (24-48h SLA)</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Zero meetings: 100% async + 2-min Looms</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>Continuous E2E & WCAG gates on new PRs</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>Pause or cancel anytime</strong> (bank unused retainer days)</span>
            </div>
          </div>
        </div>

        <!-- Right pricing box -->
        <div class="lg:col-span-5 bg-dark-800/80 p-6 sm:p-8 rounded-xl border border-dark-700 flex flex-col justify-between">
          <div>
            <div class="flex items-baseline gap-2">
              <span class="text-4xl sm:text-5xl font-black text-white">$5,495</span>
              <span class="text-slate-400 font-medium text-sm">/ month</span>
            </div>
            <p class="text-xs text-brand-400 font-mono mt-1">Pilot rate: $4,495/mo for first 2 clients</p>
            <p class="text-xs text-slate-400 mt-4 leading-relaxed">
              Replaces a $195,000 W-2 Senior SDET plus recruiting fees, equity, and benefits. Central Timezone (CST) overlap.
            </p>
          </div>

          <div class="mt-6">
            <a
              href="#book-call"
              class="w-full py-3 px-6 rounded-lg font-semibold text-center text-sm text-white bg-brand-500 hover:bg-brand-600 block transition-colors shadow-sm"
            >
              Apply for a Retainer Slot
            </a>
            <span class="block text-center text-[11px] font-mono text-slate-500 mt-2">Shared Slack Connect + Linear access</span>
          </div>
        </div>

      </div>

    </div>

    <!-- Fixed 21-Day Sprints Ledger (Structured Table / Comparative Rows) -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-white">Fixed-Scope 21-Day Sprints</h3>
        <span class="text-xs font-mono text-slate-400">Guaranteed deliverables • Zero long-term commitment</span>
      </div>

      <div class="space-y-4">
        
        <!-- Sprint A -->
        <div class="p-6 rounded-xl border border-dark-700 bg-dark-800/40 hover:bg-dark-800/70 transition-colors flex flex-col md:flex-row items-start md:items-center justify-between gap-6 interactive-card">
          <div class="max-w-2xl">
            <div class="flex items-center gap-3 mb-1">
              <span class="text-xs font-mono text-brand-400 font-semibold uppercase">Sprint A</span>
              <h4 class="text-base sm:text-lg font-bold text-white">AI-Ready Playwright Foundation</h4>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Production Playwright + TypeScript architecture built from scratch. API session state caching (&lt;50ms), top 15 critical user journeys automated, parallelized GitHub Actions CI (&lt;3 min), and custom Cursor / Claude rules for your dev team.
            </p>
          </div>
          <div class="flex items-center gap-5 flex-shrink-0 self-end md:self-center">
            <div class="text-right">
              <span class="text-2xl font-bold text-white">$5,500</span>
              <span class="block text-[11px] font-mono text-slate-400">3-Week Delivery</span>
            </div>
            <a
              href="#book-call"
              class="px-4 py-2.5 rounded-lg text-xs font-semibold text-slate-200 border border-dark-600 bg-dark-800 hover:bg-dark-700 hover:text-white transition-colors whitespace-nowrap"
            >
              Book Sprint
            </a>
          </div>
        </div>

        <!-- Sprint B -->
        <div class="p-6 rounded-xl border border-dark-700 bg-dark-800/40 hover:bg-dark-800/70 transition-colors flex flex-col md:flex-row items-start md:items-center justify-between gap-6 interactive-card">
          <div class="max-w-2xl">
            <div class="flex items-center gap-3 mb-1">
              <span class="text-xs font-mono text-indigo-400 font-semibold uppercase">Sprint B</span>
              <h4 class="text-base sm:text-lg font-bold text-white">Legacy Framework Migration (Selenium / Cypress -> Playwright)</h4>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Zero-downtime dual-run CI cutover. We convert 25-35 critical paths from brittle legacy Selenium or Cypress to Playwright + TypeScript, replace fragile XPaths with accessible locators, and slash CI runtimes by 60%+.
            </p>
          </div>
          <div class="flex items-center gap-5 flex-shrink-0 self-end md:self-center">
            <div class="text-right">
              <span class="text-2xl font-bold text-white">$6,500</span>
              <span class="block text-[11px] font-mono text-slate-400">3-Week Delivery</span>
            </div>
            <a
              href="#book-call"
              class="px-4 py-2.5 rounded-lg text-xs font-semibold text-slate-200 border border-dark-600 bg-dark-800 hover:bg-dark-700 hover:text-white transition-colors whitespace-nowrap"
            >
              Book Sprint
            </a>
          </div>
        </div>

        <!-- Sprint C -->
        <div class="p-6 rounded-xl border border-emerald-500/30 bg-emerald-950/10 hover:bg-emerald-950/20 transition-colors flex flex-col md:flex-row items-start md:items-center justify-between gap-6 interactive-card">
          <div class="max-w-2xl">
            <div class="flex items-center gap-3 mb-1">
              <span class="text-xs font-mono text-emerald-400 font-semibold uppercase">Sprint C • Compliance</span>
              <h4 class="text-base sm:text-lg font-bold text-white">WCAG 2.1 AA Frontend Migration & CI Automation</h4>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Hands-on frontend accessibility remediation (semantic DOM, ARIA states, keyboard traps, focus restoration) + automated @axe-core and VoiceOver regression gates in CI. Prepares your product for VPAT 2.5 filings.
            </p>
          </div>
          <div class="flex items-center gap-5 flex-shrink-0 self-end md:self-center">
            <div class="text-right">
              <span class="text-2xl font-bold text-white">$7,500</span>
              <span class="block text-[11px] font-mono text-slate-400">3-Week Delivery</span>
            </div>
            <a
              href="#book-call"
              class="px-4 py-2.5 rounded-lg text-xs font-semibold text-dark-900 bg-emerald-400 hover:bg-emerald-300 transition-colors whitespace-nowrap font-bold"
            >
              Book Sprint
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- The 48-Hour Diagnostic Wedge -->
    <div class="p-6 rounded-xl border border-dark-700 bg-dark-800/60 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 interactive-card">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-mono text-brand-400 font-semibold uppercase">Low-Risk Diagnostic</span>
          <span class="text-xs text-emerald-400 font-medium">• 100% credited toward any sprint</span>
        </div>
        <h4 class="text-base sm:text-lg font-bold text-white">48-Hour Test Velocity & WCAG Risk Audit</h4>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-2xl leading-relaxed">
          Not ready for a full sprint? I will inspect your repo and deliver a 20-minute video diagnostic covering flaky selectors, CI bottlenecks, and WCAG AA violation hotspots + a 30-day action plan in 48 hours.
        </p>
      </div>
      <div class="flex items-center gap-5 flex-shrink-0 self-end md:self-center">
        <div class="text-right">
          <span class="text-2xl font-bold text-white">$950</span>
          <span class="block text-[11px] font-mono text-slate-400">Fixed Fee</span>
        </div>
        <a
          href="#book-call"
          class="px-5 py-2.5 rounded-lg font-semibold text-xs text-white bg-slate-700 hover:bg-slate-600 transition-colors whitespace-nowrap"
        >
          Order 48-Hr Audit
        </a>
      </div>
    </div>

  </div>
</section>
