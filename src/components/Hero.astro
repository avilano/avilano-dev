---
---
<section class="relative pt-16 pb-16 md:pt-24 md:pb-24 overflow-hidden border-b border-dark-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 text-left">
        
        <!-- Architectural Status Badge -->
        <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-md border border-dark-700 bg-dark-800 text-xs font-mono text-slate-300 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Ex-Pinterest SDET II • Ex-Coursedog • AWS Certified</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-[1.1]">
          Ship Frontend Releases Fast. <br />
          <span class="text-slate-400 font-semibold">Zero Flaky Tests. 100% WCAG Accessible.</span>
        </h1>

        <!-- Subheadline -->
        <p class="mt-6 text-base sm:text-lg text-slate-300 max-w-xl leading-relaxed">
          Partner with an independent Senior QA Architect with 8+ years scaling test systems for <strong>Pinterest</strong> and <strong>Coursedog</strong>. We build zero-flake Playwright test suites, eliminate release bottlenecks, and enforce continuous WCAG 2.1 AA compliance — on a flat monthly subscription.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col sm:flex-row items-center gap-3.5">
          <a
            href="#services"
            class="w-full sm:w-auto px-6 py-3.5 text-sm font-semibold rounded-lg text-white bg-brand-500 hover:bg-brand-600 transition-colors flex items-center justify-center gap-2 shadow-sm"
          >
            <span>View Sprints & Retainer</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </a>
          <a
            href="#book-call"
            class="w-full sm:w-auto px-6 py-3.5 text-sm font-semibold rounded-lg text-slate-200 border border-dark-700 bg-dark-800/80 hover:bg-dark-700 hover:text-white transition-colors flex items-center justify-center gap-2"
          >
            <span>Book a 15-Min Fit Call</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          </a>
        </div>

        <!-- Micro Guarantees -->
        <div class="mt-8 flex flex-wrap items-center gap-6 text-xs font-mono text-slate-400">
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-400">✓</span> 100% Async • No Meetings
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-400">✓</span> Pause / Cancel Anytime
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-400">✓</span> North America (CST)
          </span>
        </div>

      </div>

      <!-- Right Column: Tactile Engineering Proof (Terminal / Test Runner Widget) -->
      <div class="lg:col-span-5">
        <div class="rounded-xl border border-dark-700 bg-dark-900 shadow-2xl overflow-hidden font-mono text-xs">
          
          <!-- Terminal Header -->
          <div class="px-4 py-3 bg-dark-800/80 border-b border-dark-700/80 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
              <span class="ml-2 text-slate-400 text-[11px]">playwright-ci-runner — sharded</span>
            </div>
            <span class="text-emerald-400 text-[11px] font-bold">PASSING</span>
          </div>

          <!-- Terminal Body -->
          <div class="p-5 space-y-3 bg-[#070a11]">
            <div class="text-slate-400 text-[11px]">
              $ npx playwright test --project=chromium
            </div>
            
            <div class="space-y-2 pt-1">
              <div class="flex items-start justify-between text-slate-300">
                <span class="text-emerald-400">✓ <span class="text-slate-200">tests/e2e/auth-session.spec.ts</span></span>
                <span class="text-slate-500 text-[11px]">42ms</span>
              </div>
              <p class="text-[11px] text-slate-400 pl-4">→ API storageState cached (<span class="text-emerald-300">zero UI lag</span>)</p>

              <div class="flex items-start justify-between text-slate-300 pt-1">
                <span class="text-emerald-400">✓ <span class="text-slate-200">tests/a11y/checkout-wcag.spec.ts</span></span>
                <span class="text-slate-500 text-[11px]">280ms</span>
              </div>
              <p class="text-[11px] text-slate-400 pl-4">→ @axe-core: 0 critical/serious WCAG 2.1 AA violations</p>

              <div class="flex items-start justify-between text-slate-300 pt-1">
                <span class="text-emerald-400">✓ <span class="text-slate-200">tests/keyboard/focus-trap.spec.ts</span></span>
                <span class="text-slate-500 text-[11px]">195ms</span>
              </div>
              <p class="text-[11px] text-slate-400 pl-4">→ W3C APG: Focus trapped; Escape restored trigger</p>

              <div class="flex items-start justify-between text-slate-300 pt-1">
                <span class="text-emerald-400">✓ <span class="text-slate-200">tests/screen-reader/voiceover.spec.ts</span></span>
                <span class="text-slate-500 text-[11px]">410ms</span>
              </div>
              <p class="text-[11px] text-slate-400 pl-4">→ Guidepup: VoiceOver spoke "Cart updated"</p>
            </div>

            <!-- Terminal Summary -->
            <div class="pt-3 border-t border-dark-800 text-[11px] flex items-center justify-between">
              <span class="text-emerald-400 font-bold">4 passed (1.8s)</span>
              <span class="text-slate-400">CI Shard 1/2 complete</span>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Pedigree & Enterprise Track Record Bar -->
    <div class="mt-14 pt-8 border-t border-dark-800/80">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-left font-mono">
        <div>
          <span class="block text-2xl font-black text-white">1,200+</span>
          <span class="text-[11px] text-slate-400">Tests Scaled at Pinterest</span>
        </div>
        <div>
          <span class="block text-2xl font-black text-white">200+</span>
          <span class="text-[11px] text-slate-400">Migrated to Playwright (Coursedog)</span>
        </div>
        <div>
          <span class="block text-2xl font-black text-white">8+ Years</span>
          <span class="text-[11px] text-slate-400">Distributed & Full-Stack Testing</span>
        </div>
        <div>
          <span class="block text-2xl font-black text-white">B.S. Physics</span>
          <span class="text-[11px] text-slate-400">Univ. of Texas • AWS Certified</span>
        </div>
      </div>
    </div>

    <!-- Tech Stack Row (Clean Monochrome Vector Labels, No Emojis) -->
    <div class="mt-8 pt-6 border-t border-dark-800/40">
      <div class="flex flex-wrap items-center justify-between gap-6 text-xs font-mono text-slate-400">
        <span class="text-slate-500 uppercase tracking-wider text-[11px]">Core Architecture</span>
        <div class="flex flex-wrap items-center gap-6 sm:gap-8 text-slate-300">
          <span class="hover:text-white transition-colors">Playwright 1.49+</span>
          <span class="hover:text-white transition-colors">@axe-core/playwright</span>
          <span class="hover:text-white transition-colors">Guidepup VoiceOver</span>
          <span class="hover:text-white transition-colors">TypeScript</span>
          <span class="hover:text-white transition-colors">Cursor / Claude MCP Rules</span>
          <span class="hover:text-white transition-colors">GitHub Actions CI</span>
        </div>
      </div>
    </div>

  </div>
</section>
