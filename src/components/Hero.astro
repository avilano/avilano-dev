---
---
<section class="relative pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
    
    <!-- Top Pill / Alert Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-brand-500/30 bg-brand-500/10 text-brand-300 text-xs sm:text-sm font-medium mb-8">
      <span class="flex h-2 w-2 rounded-full bg-brand-400 animate-pulse"></span>
      <span>2026/2027 US Mandates Ready: DOJ ADA Title II & HHS Section 504</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-[1.1]">
      Ship Frontend Features at AI Speed. <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 via-sky-300 to-indigo-400">
        Zero Flaky Tests. 100% WCAG Accessible.
      </span>
    </h1>

    <!-- Subheadline -->
    <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
      A dedicated Senior AI QA & Frontend Accessibility Architect embedded in your team. 
      Automate Playwright test suites, eliminate flaky CI failures, and achieve continuous legal WCAG 2.1 AA compliance — on a flat monthly subscription.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#services"
        class="w-full sm:w-auto px-8 py-3.5 text-base font-semibold rounded-xl text-white bg-gradient-to-r from-brand-500 to-indigo-600 hover:from-brand-600 hover:to-indigo-700 shadow-xl shadow-brand-500/25 transition-all hover:scale-[1.02] flex items-center justify-center gap-2"
      >
        <span>Explore Sprints & Retainers</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
      </a>
      <a
        href="#book-call"
        class="w-full sm:w-auto px-8 py-3.5 text-base font-semibold rounded-xl text-slate-200 border border-dark-600 bg-dark-800/80 hover:bg-dark-700 hover:text-white transition-all flex items-center justify-center gap-2"
      >
        <span>Book a 15-Min Fit Call</span>
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
      </a>
    </div>

    <!-- Micro Guarantees -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-xs sm:text-sm text-slate-400">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
        100% Async • No Status Meetings
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
        Pause or Cancel Anytime
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
        North America Timezones (CST)
      </span>
    </div>

    <!-- Tech Stack Logos / Badges -->
    <div class="mt-16 pt-10 border-t border-dark-800/80">
      <p class="text-xs uppercase tracking-wider font-mono text-slate-500 mb-6">Battle-Tested Modern Stack & Compliant Standards</p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12 opacity-75 grayscale hover:grayscale-0 transition-all text-sm font-mono text-slate-300">
        <span class="flex items-center gap-2 hover:text-white">🎭 Playwright</span>
        <span class="flex items-center gap-2 hover:text-white">♿ @axe-core</span>
        <span class="flex items-center gap-2 hover:text-white">🎙️ Guidepup VoiceOver</span>
        <span class="flex items-center gap-2 hover:text-white">🔷 TypeScript</span>
        <span class="flex items-center gap-2 hover:text-white">🤖 Cursor & Claude Agents</span>
        <span class="flex items-center gap-2 hover:text-white">⚡ GitHub Actions</span>
      </div>
    </div>

  </div>
</section>
