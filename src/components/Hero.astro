---
---
<section class="relative pt-14 pb-16 md:pt-24 md:pb-24 overflow-hidden border-b border-zinc-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 text-left">
        <!-- Architectural Status Badge -->
        <div class="hero-fade-1 inline-flex items-center gap-2.5 px-3 py-1 rounded-md border border-zinc-200 bg-white text-xs font-mono text-zinc-700 mb-6 shadow-2xs">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600" aria-hidden="true"></span>
          <span>Senior SDET &amp; AI Quality Engineer</span>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-fade-2 text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-zinc-950 leading-[1.08]">
          Ship Frontend Releases Fast. <br />
          <span class="text-zinc-600 font-semibold">Flake-Resilient Tests. 100% WCAG Accessible.</span>
        </h1>

        <!-- Subheadline -->
        <p class="hero-fade-2 mt-6 text-base sm:text-lg text-zinc-600 max-w-xl leading-relaxed">
          Partner with an independent Senior SDET and AI Quality Engineer with 8+ years scaling enterprise test systems and distributed CI pipelines. We build flake-resilient Playwright test suites, eliminate release bottlenecks, and enforce continuous WCAG 2.1 AA compliance on a flat monthly subscription.
        </p>

        <!-- Primary + Subtle Secondary CTAs -->
        <div class="hero-fade-3 mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
          <a
            href="#qa-diagnostic"
            class="w-full sm:w-auto px-6 py-3.5 text-sm font-semibold rounded-md text-white bg-zinc-950 hover:bg-zinc-800 transition-colors inline-flex items-center justify-center gap-2 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600"
          >
            <span>Run Free 60-Sec QA Diagnostic</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="#book-call"
            class="w-full sm:w-auto px-5 py-3.5 text-sm font-medium rounded-md text-zinc-800 border border-zinc-300 bg-white hover:border-zinc-400 hover:text-zinc-950 hover:bg-zinc-50 transition-colors inline-flex items-center justify-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600"
          >
            <span>Book a 15-Min Fit Call</span>
            <span class="text-zinc-500" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Micro Guarantees -->
        <div class="hero-fade-3 mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-mono text-zinc-600">
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-700 font-bold" aria-hidden="true">✓</span> Instant 0-100 Score · Actionable Teardown
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-700 font-bold" aria-hidden="true">✓</span> Pause / Cancel Anytime
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-700 font-bold" aria-hidden="true">✓</span> North America (CST)
          </span>
        </div>
      </div>

      <!-- Right Column: Dark Code/Terminal Island -->
      <div class="lg:col-span-5 hero-fade-terminal">
        <div class="rounded-lg border border-dark-700 bg-dark-900 shadow-2xl overflow-hidden font-mono text-xs">
          <!-- Terminal Header -->
          <div class="px-4 py-3 bg-dark-800 border-b border-dark-700 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80" aria-hidden="true"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80" aria-hidden="true"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80" aria-hidden="true"></span>
              <span class="ml-2 text-slate-400 text-[11px]">playwright-ci-runner (sharded)</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-emerald-400 text-[11px] font-bold">PASSING</span>
            </div>
          </div>

          <!-- Terminal Body -->
          <div class="p-5 space-y-3 bg-[#090d16]">
            <div class="text-slate-400 text-[11px] flex items-center">
              <span>$ npx playwright test --project=chromium</span>
              <span class="inline-block w-1.5 h-3.5 bg-brand-400 ml-1.5 animate-pulse" aria-hidden="true"></span>
            </div>

            <div class="space-y-2 pt-1">
              <div class="flex items-start justify-between text-slate-300 gap-2">
                <span class="text-emerald-400">✓ <span class="text-slate-100">tests/e2e/auth-session.spec.ts</span></span>
                <span class="text-slate-400 text-[11px] font-mono shrink-0">42ms</span>
              </div>
              <p class="text-[11px] text-slate-400 pl-4">→ API storageState cached (<span class="text-emerald-300">zero UI lag</span>)</p>

              <div class="flex items-start justify-between text-slate-300 pt-1 gap-2">
                <span class="text-emerald-400">✓ <span class="text-slate-100">tests/a11y/checkout-wcag.spec.ts</span></span>
                <span class="text-slate-400 text-[11px] font-mono shrink-0">280ms</span>
              </div>
              <p class="text-[11px] text-slate-400 pl-4">→ @axe-core: 0 critical/serious WCAG 2.1 AA violations</p>

              <div class="flex items-start justify-between text-slate-300 pt-1 gap-2">
                <span class="text-emerald-400">✓ <span class="text-slate-100">tests/keyboard/focus-trap.spec.ts</span></span>
                <span class="text-slate-400 text-[11px] font-mono shrink-0">195ms</span>
              </div>
              <p class="text-[11px] text-slate-400 pl-4">→ W3C APG: Focus trapped; Escape restored trigger</p>

              <div class="flex items-start justify-between text-slate-300 pt-1 gap-2">
                <span class="text-emerald-400">✓ <span class="text-slate-100">tests/screen-reader/voiceover.spec.ts</span></span>
                <span class="text-slate-400 text-[11px] font-mono shrink-0">410ms</span>
              </div>
              <p class="text-[11px] text-slate-400 pl-4">→ Guidepup: VoiceOver spoke "Cart updated"</p>
            </div>

            <!-- Terminal Summary -->
            <div class="pt-3 border-t border-dark-700 text-[11px] flex items-center justify-between">
              <span class="text-emerald-400 font-bold">4 passed (1.8s)</span>
              <span class="text-slate-400">CI Shard 1/2 complete</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
