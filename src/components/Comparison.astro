---
---
<section id="comparison" class="py-16 bg-dark-800/30 border-y border-dark-700/50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-xs font-mono uppercase tracking-wider text-brand-400 font-semibold mb-2">The Economic Comparison</h2>
      <h3 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Why SaaS Leaders Choose the Async Model
      </h3>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-300 border-collapse">
        <thead>
          <tr class="border-b border-dark-700">
            <th class="py-4 px-4 font-semibold text-slate-400">Criteria</th>
            <th class="py-4 px-4 font-semibold text-slate-400">Full-Time W-2 SDET</th>
            <th class="py-4 px-4 font-semibold text-slate-400">Legacy A11y Agency</th>
            <th class="py-4 px-4 font-bold text-brand-400 bg-brand-500/10 rounded-t-xl">avilano.dev</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-dark-700/60 font-mono text-xs sm:text-sm">
          <tr>
            <td class="py-4 px-4 font-sans font-medium text-white">Cost & Commitment</td>
            <td class="py-4 px-4 text-slate-400">$180k–$220k/yr + Equity</td>
            <td class="py-4 px-4 text-slate-400">$30k–$75k per static audit</td>
            <td class="py-4 px-4 text-brand-300 font-bold bg-brand-500/5">$5,495/mo (Pause/Cancel anytime)</td>
          </tr>
          <tr>
            <td class="py-4 px-4 font-sans font-medium text-white">Time to Start</td>
            <td class="py-4 px-4 text-slate-400">2–4 months recruiting</td>
            <td class="py-4 px-4 text-slate-400">3–6 weeks RFP process</td>
            <td class="py-4 px-4 text-emerald-400 font-bold bg-brand-500/5">Under 48 hours</td>
          </tr>
          <tr>
            <td class="py-4 px-4 font-sans font-medium text-white">Code Deliverables</td>
            <td class="py-4 px-4 text-slate-400">Writes code internally</td>
            <td class="py-4 px-4 text-rose-400">❌ Only 100-page PDF reports</td>
            <td class="py-4 px-4 text-emerald-400 font-bold bg-brand-500/5">✅ Direct PRs & CI pipeline code</td>
          </tr>
          <tr>
            <td class="py-4 px-4 font-sans font-medium text-white">CI Automated Gates</td>
            <td class="py-4 px-4 text-slate-400">Often struggles with flakiness</td>
            <td class="py-4 px-4 text-rose-400">❌ None (Manual audit only)</td>
            <td class="py-4 px-4 text-emerald-400 font-bold bg-brand-500/5">✅ Sub-3min Playwright + Axe CI</td>
          </tr>
          <tr>
            <td class="py-4 px-4 font-sans font-medium text-white">Management Overhead</td>
            <td class="py-4 px-4 text-slate-400">High (1:1s, reviews, benefits)</td>
            <td class="py-4 px-4 text-slate-400">Weekly vendor status calls</td>
            <td class="py-4 px-4 text-emerald-400 font-bold bg-brand-500/5">Zero (100% Async + 2-min Looms)</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>
