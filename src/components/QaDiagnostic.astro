              href="mailto:contact@avilano.dev"
              class="text-sky-700 font-medium underline underline-offset-2 hover:text-zinc-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 rounded"
            >
              contact@avilano.dev
            </a>
