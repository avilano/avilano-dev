    <div class="mt-6 text-center">
      <a
        id="diag-reveal-offers-link"
        href="#services"
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-zinc-600 hover:text-zinc-950 underline underline-offset-4 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 rounded px-2 py-1"
      >
        Already know your scope? Jump to sprints &amp; pricing
      </a>
    </div>
  </div>
</section>

<script>
  function trackAnalyticsEvent(
    eventName: string,
    data?: Record<string, string | number>
  ): void {
    const va = (
      window as unknown as {
        va?: ((event: 'event', properties?: unknown) => void) & {
          track?: (event: string, properties?: Record<string, string | number>) => void;
        };
      }
    ).va;

    if (typeof va?.track === 'function') {
      va.track(eventName, data);
    } else if (typeof va === 'function') {
      va('event', { name: eventName, data });
    }
  }

  const STEP_META: Record<number, { title: string; percent: number }> = {
    1: { title: 'Step 1 of 5: CI Speed & Determinism', percent: 20 },
    2: { title: 'Step 2 of 5: Pre-Merge Release Gating', percent: 40 },
    3: { title: 'Step 3 of 5: WCAG 2.1 AA & AI Safety Gates', percent: 60 },
    4: { title: 'Step 4 of 5: Routing & Team Scale', percent: 80 },
    5: { title: 'Step 5 of 5: Unlock Your QA Readiness Report', percent: 100 },
  };

  const TEAM_MULTIPLIER: Record<string, number> = {
    '1-10': 6,
    '11-40': 22,
    '41-100': 65,
    '100+': 120,
  };

  const CI_HOURS_PER_DEV: Record<number, number> = {
    40: 0.3,
    24: 1.2,
    8: 2.8,
    4: 2.0,
  };

  const GATE_HOURS_PER_DEV: Record<number, number> = {
    35: 0.1,
    20: 0.5,
    10: 1.1,
    5: 0.8,
  };

  const SPRINT_DESCRIPTIONS: Record<string, string> = {
    'AI-Ready Playwright Foundation':
      'Stand up a production Playwright + TypeScript suite with API auth caching, sharded GitHub Actions CI (<3 min), and deterministic locators in 21 days.',
    'Legacy Framework Migration':
      'Zero-downtime dual-run cutover from brittle Cypress or Selenium suites to parallelized Playwright + TypeScript, cutting CI runtimes by 60%+.',
    'WCAG 2.1 AA Frontend Migration':
      'Hands-on semantic DOM, ARIA, and keyboard remediation paired with automated @axe-core CI regression gates to prepare for VPAT 2.5 filings.',
    'AI Eval Gate Sprint':
      'Deterministic CI evaluation harnesses for LLM and agentic workflows, catching prompt regressions, hallucinated tool calls, and latency drift pre-merge.',
    'Fractional Retainer':
      'Dedicated async Senior SDET & AI Quality partner in a shared Linear queue to keep your hardened pipeline fast as your engineering org scales.',
  };

  function getTier(score: number): {
    label: string;
    summary: string;
    badgeClass: string;
  } {
    if (score <= 44) {
      return {
        label: 'High Release Drag',
        summary:
          'Flaky checks or missing pre-merge gates are taxing engineering velocity and pushing regression risk into production.',
        badgeClass: 'border-rose-300 bg-rose-50 text-rose-900',
      };
    }
    if (score <= 74) {
      return {
        label: 'Scaling Bottleneck',
        summary:
          'You have foundational coverage in place, but slow CI feedback loops or unautomated compliance gates will compound as your team grows.',
        badgeClass: 'border-amber-300 bg-amber-50 text-amber-900',
      };
    }
    return {
      label: 'Hardened Pipeline',
      summary:
        'Your release gates are strong. Focus on preserving low CI latency, expanding AI eval coverage, and preventing drift across new features.',
      badgeClass: 'border-emerald-300 bg-emerald-50 text-emerald-900',
    };
  }

  function getRecommendedSprint(
    primaryFriction: string,
    ciScore: number,
    totalScore: number,
    teamScale: string
  ): string {
    if (primaryFriction === 'WCAG 2.1 AA / ADA Title II gaps') {
      return 'WCAG 2.1 AA Frontend Migration';
    }
    if (primaryFriction === 'Unreliable AI/LLM agent outputs') {
      return 'AI Eval Gate Sprint';
    }
    if (primaryFriction === 'Slow CI / Cypress or Selenium') {
      return 'Legacy Framework Migration';
    }
    if (totalScore >= 75) {
      return 'Fractional Retainer';
    }
    if (ciScore === 4) {
      return 'AI-Ready Playwright Foundation';
    }
    if (teamScale === '41-100' || teamScale === '100+') {
      return 'Fractional Retainer';
    }
    return 'AI-Ready Playwright Foundation';
  }

  interface DiagnosticResult {
    ciScore: number;
    gateScore: number;
    wcagScore: number;
    totalScore: number;
    ciLabel: string;
    gateLabel: string;
    wcagLabel: string;
    primaryFriction: string;
    teamScale: string;
    notes: string;
    tier: {
      label: string;
      summary: string;
      badgeClass: string;
    };
    weeklyHoursLost: number;
    recommendedSprint: string;
  }

  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function initQaDiagnostic(): void {
    const section = document.getElementById('qa-diagnostic');
    const form = document.getElementById('diag-form') as HTMLFormElement | null;
    const progressHeader = document.getElementById('diag-progress-header');
    const stepLabel = document.getElementById('diag-step-label');
    const stepPercent = document.getElementById('diag-step-percent');
    const progressTrack = document.getElementById('diag-progress-bar-track');
    const progressFill = document.getElementById('diag-progress-bar-fill');
    const errorBox = document.getElementById('diag-error');
    const prevBtn = document.getElementById('diag-prev-btn');
    const nextBtn = document.getElementById('diag-next-btn');
    const submitBtn = document.getElementById('diag-submit-btn') as HTMLButtonElement | null;
    const nameInput = document.getElementById('diag-name') as HTMLInputElement | null;
    const companyInput = document.getElementById('diag-company') as HTMLInputElement | null;
    const emailInput = document.getElementById('diag-email') as HTMLInputElement | null;
    const websiteInput = document.getElementById('diag-website') as HTMLInputElement | null;
    const copySummaryBtn = document.getElementById('res-copy-summary-btn') as HTMLButtonElement | null;
    const copyStatus = document.getElementById('res-copy-status');
    const emailLink = document.getElementById('res-email-link') as HTMLAnchorElement | null;
    const syncNotice = document.getElementById('res-sync-notice');
    const reviewCiSpeed = document.getElementById('review-ci-speed');
    const reviewReleaseGate = document.getElementById('review-release-gate');
    const reviewWcagAi = document.getElementById('review-wcag-ai');
    const reviewFrictionScale = document.getElementById('review-friction-scale');
    const resultsPanel = document.getElementById('diag-results');
    const resetBtn = document.getElementById('diag-reset-btn');
    const calCta = document.getElementById('res-cal-cta');

    if (!section || !form || !prevBtn || !nextBtn || !resultsPanel) {
      return;
    }

    const steps = Array.from(form.querySelectorAll<HTMLElement>('.diag-step'));
    const contactInputs = [nameInput, companyInput, emailInput].filter(
      (el): el is HTMLInputElement => el !== null
    );
    let currentStep = 1;
    const totalSteps = steps.length;
    let isResultsUnlocked = false;
    let isSubmitting = false;
    let suppressFocusClearEl: HTMLInputElement | null = null;
    let lastFormattedSummary = '';

    const showError = (msg: string) => {
      if (!errorBox) return;
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
    };

    const clearError = () => {
      if (!errorBox) return;
      errorBox.textContent = '';
      errorBox.classList.add('hidden');
    };

    const validateContactField = (input: HTMLInputElement): string | null => {
      const value = input.value.trim();
      if (input.id === 'diag-name') {
        if (value.length < 1 || value.length > 120) {
          return 'Enter your name (1 to 120 characters).';
        }
        return null;
      }
      if (input.id === 'diag-company') {
        if (value.length < 1 || value.length > 120) {
          return 'Enter your company name (1 to 120 characters).';
        }
        return null;
      }
      if (input.id === 'diag-email') {
        if (value.length < 1 || value.length > 254 || !EMAIL_REGEX.test(value)) {
          return 'Enter a valid work email address.';
        }
        return null;
      }
      return null;
    };

    const setFieldError = (input: HTMLInputElement, message: string) => {
      const errorId = `${input.id}-error`;
      const fieldErrorEl = document.getElementById(errorId);
      input.setAttribute('aria-invalid', 'true');
      input.setAttribute('aria-describedby', errorId);
      input.classList.remove('border-zinc-300');
      input.classList.add('border-rose-600');
      if (fieldErrorEl) {
        const textEl = fieldErrorEl.querySelector('.diag-field-error-text');
        if (textEl) {
          textEl.textContent = message;
        }
        fieldErrorEl.classList.remove('hidden');
      }
    };

    const clearFieldError = (input: HTMLInputElement) => {
      const errorId = `${input.id}-error`;
      const fieldErrorEl = document.getElementById(errorId);
      input.removeAttribute('aria-invalid');
      input.removeAttribute('aria-describedby');
      input.classList.remove('border-rose-600');
      input.classList.add('border-zinc-300');
      if (fieldErrorEl) {
        const textEl = fieldErrorEl.querySelector('.diag-field-error-text');
        if (textEl) {
          textEl.textContent = '';
        }
        fieldErrorEl.classList.add('hidden');
      }
    };

    const clearAllFieldErrors = () => {
      contactInputs.forEach((input) => clearFieldError(input));
    };

    contactInputs.forEach((input) => {
      input.addEventListener('blur', () => {
        const errorMessage = validateContactField(input);
        if (errorMessage) {
          setFieldError(input, errorMessage);
        } else {
          clearFieldError(input);
        }
      });

      input.addEventListener('focus', () => {
        if (suppressFocusClearEl === input) {
          suppressFocusClearEl = null;
          return;
        }
        clearFieldError(input);
      });

      input.addEventListener('input', () => {
        clearFieldError(input);
      });
    });

    const getCheckedRadio = (name: string): HTMLInputElement | null => {
      return form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
    };

    const updateFinalReviewSummary = () => {
      const ciInput = getCheckedRadio('ci_speed');
      const gateInput = getCheckedRadio('release_gate');
      const wcagInput = getCheckedRadio('wcag_ai');
      const frictionInput = getCheckedRadio('primary_friction');
      const scaleInput = getCheckedRadio('team_scale');

      if (reviewCiSpeed) {
        reviewCiSpeed.textContent = ciInput?.dataset.label || 'Not selected';
      }
      if (reviewReleaseGate) {
        reviewReleaseGate.textContent = gateInput?.dataset.label || 'Not selected';
      }
      if (reviewWcagAi) {
        reviewWcagAi.textContent = wcagInput?.dataset.label || 'Not selected';
      }
      if (reviewFrictionScale) {
        const friction = frictionInput?.value || '';
        const scale = scaleInput?.value || '';
        if (friction && scale) {
          reviewFrictionScale.textContent = `${friction} (${scale} engineers)`;
        } else {
          reviewFrictionScale.textContent = friction || scale || 'Not selected';
        }
      }
    };

    const computeDiagnosticResult = (): DiagnosticResult => {
      const ciInput = getCheckedRadio('ci_speed');
      const gateInput = getCheckedRadio('release_gate');
      const wcagInput = getCheckedRadio('wcag_ai');
      const frictionInput = getCheckedRadio('primary_friction');
      const scaleInput = getCheckedRadio('team_scale');

      const ciScore = Number(ciInput?.value || 0);
      const gateScore = Number(gateInput?.value || 0);
      const wcagScore = Number(wcagInput?.value || 0);
      const totalScore = ciScore + gateScore + wcagScore;

      const ciLabel = ciInput?.dataset.label || String(ciScore);
      const gateLabel = gateInput?.dataset.label || String(gateScore);
      const wcagLabel = wcagInput?.dataset.label || String(wcagScore);
      const primaryFriction = frictionInput?.value || '';
      const teamScale = scaleInput?.value || '1-10';
      const notes = (form.querySelector<HTMLTextAreaElement>('#diag-notes')?.value || '').trim();

      const tier = getTier(totalScore);
      const multiplier = TEAM_MULTIPLIER[teamScale] ?? 6;
      const hoursPerDev =
        (CI_HOURS_PER_DEV[ciScore] ?? 1.2) + (GATE_HOURS_PER_DEV[gateScore] ?? 0.5);
      const weeklyHoursLost = Math.max(2, Math.round(multiplier * hoursPerDev));
      const recommendedSprint = getRecommendedSprint(
        primaryFriction,
        ciScore,
        totalScore,
        teamScale
      );

      return {
        ciScore,
        gateScore,
        wcagScore,
        totalScore,
        ciLabel,
        gateLabel,
        wcagLabel,
        primaryFriction,
        teamScale,
        notes,
        tier,
        weeklyHoursLost,
        recommendedSprint,
      };
    };

    const formatDiagnosticSummary = (result: DiagnosticResult): string => {
      return [
        `QA & CI Pipeline Diagnostic Scorecard`,
        `Total Score: ${result.totalScore}/100 (${result.tier.label})`,
        `CI Speed & Determinism: ${result.ciLabel} (${result.ciScore}/40)`,
        `Pre-Merge Release Gating: ${result.gateLabel} (${result.gateScore}/35)`,
        `WCAG 2.1 AA & AI Safety Gates: ${result.wcagLabel} (${result.wcagScore}/25)`,
        `Primary Friction: ${result.primaryFriction}`,
        `Engineering Scale: ${result.teamScale}`,
        `Estimated Weekly Eng Hours Lost: ~${result.weeklyHoursLost} hrs/wk`,
        `Recommended Sprint: ${result.recommendedSprint}`,
        result.notes ? `Notes: ${result.notes}` : '',
      ]
        .filter(Boolean)
        .join('\n');
    };

    const updateSummaryExports = (result: DiagnosticResult) => {
      lastFormattedSummary = formatDiagnosticSummary(result);
      if (copySummaryBtn) {
        copySummaryBtn.textContent = 'Copy Diagnostic Summary';
      }
      if (copyStatus) {
        copyStatus.textContent = '';
      }
      if (emailLink) {
        const subject = `QA & CI Diagnostic Scorecard (${result.totalScore}/100 - ${result.tier.label})`;
        emailLink.href = `mailto:contact@avilano.dev?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lastFormattedSummary)}`;
      }
    };

    const unlockResultsView = (result: DiagnosticResult, submissionFailed = false) => {
      if (isResultsUnlocked) return;
      isResultsUnlocked = true;
      updateSummaryExports(result);

      const setElText = (id: string, text: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };

      setElText('res-total-score', String(result.totalScore));
      setElText('res-tier-summary', result.tier.summary);
      setElText('res-hours-lost', String(result.weeklyHoursLost));
      setElText('res-sprint-name', result.recommendedSprint);
      setElText('res-sprint-desc', SPRINT_DESCRIPTIONS[result.recommendedSprint] || '');

      const badge = document.getElementById('res-tier-badge');
      if (badge) {
        badge.textContent = result.tier.label;
        badge.className = `inline-flex items-center px-3.5 py-1.5 rounded-md border text-xs font-mono font-bold uppercase tracking-wider ${result.tier.badgeClass}`;
      }

      const updateBar = (
        textId: string,
        barId: string,
        trackId: string,
        val: number,
        max: number
      ) => {
        setElText(textId, `${val} / ${max}`);
        const bar = document.getElementById(barId);
        const track = document.getElementById(trackId);
        if (bar) bar.style.width = `${Math.round((val / max) * 100)}%`;
        if (track) track.setAttribute('aria-valuenow', String(val));
      };

      updateBar('res-ci-text', 'res-ci-bar', 'res-ci-track', result.ciScore, 40);
      updateBar('res-gate-text', 'res-gate-bar', 'res-gate-track', result.gateScore, 35);
      updateBar('res-wcag-text', 'res-wcag-bar', 'res-wcag-track', result.wcagScore, 25);

      syncNotice?.classList.toggle('hidden', !submissionFailed);

      clearError();
      form.classList.add('hidden');
      progressHeader?.classList.add('hidden');
      resultsPanel.classList.remove('hidden');
      resultsPanel.focus();

      window.dispatchEvent(new CustomEvent('qa-diagnostic:unlocked'));

      trackAnalyticsEvent('qa_diagnostic_completed', {
        score: result.totalScore,
        tier: result.tier.label,
        recommended_sprint: result.recommendedSprint,
      });
    };

    const updateStepUI = () => {
      clearError();
      if (currentStep !== totalSteps) {
        clearAllFieldErrors();
      } else {
        updateFinalReviewSummary();
      }

      steps.forEach((el) => {
        const stepNum = Number(el.dataset.step);
        el.classList.toggle('hidden', stepNum !== currentStep);
      });

      const meta = STEP_META[currentStep];
      if (meta) {
        if (stepLabel) stepLabel.textContent = meta.title;
        if (stepPercent) stepPercent.textContent = `${meta.percent}%`;
        if (progressTrack) progressTrack.setAttribute('aria-valuenow', String(meta.percent));
        if (progressFill) progressFill.style.width = `${meta.percent}%`;
      }

      prevBtn.classList.toggle('hidden', currentStep === 1);
      nextBtn.classList.toggle('hidden', currentStep === totalSteps);
    };

    const validateStep = (step: number): boolean => {
      if (step === 1 && !getCheckedRadio('ci_speed')) {
        showError('Select an option for CI speed and flake frequency to continue.');
        return false;
      }
      if (step === 2 && !getCheckedRadio('release_gate')) {
        showError('Select how critical user flows are verified before merging.');
        return false;
      }
      if (step === 3 && !getCheckedRadio('wcag_ai')) {
        showError('Select how WCAG 2.1 AA or AI/LLM outputs are verified in CI.');
        return false;
      }
      if (step === 4) {
        if (!getCheckedRadio('primary_friction')) {
          showError('Select your primary engineering friction point to continue.');
          return false;
        }
        if (!getCheckedRadio('team_scale')) {
          showError('Select your engineering team scale to estimate weekly hours lost.');
          return false;
        }
      }
      return true;
    };

    const advanceStep = () => {
      if (!validateStep(currentStep)) return;
      if (currentStep < totalSteps) {
        currentStep += 1;
        updateStepUI();
        if (currentStep === totalSteps) {
          nameInput?.focus();
        }
      }
    };

    nextBtn.addEventListener('click', advanceStep);

    prevBtn.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep -= 1;
        updateStepUI();
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (currentStep < totalSteps) {
        advanceStep();
        return;
      }

      if (isSubmitting || isResultsUnlocked) return;

      const name = (nameInput?.value || '').trim();
      const company = (companyInput?.value || '').trim();
      const email = (emailInput?.value || '').trim();
      const website = (websiteInput?.value || '').trim();

      let firstInvalidField: HTMLInputElement | null = null;
      contactInputs.forEach((input) => {
        const errorMessage = validateContactField(input);
        if (errorMessage) {
          setFieldError(input, errorMessage);
          if (!firstInvalidField) {
            firstInvalidField = input;
          }
        } else {
          clearFieldError(input);
        }
      });

      if (firstInvalidField) {
        clearError();
        suppressFocusClearEl = firstInvalidField;
        (firstInvalidField as HTMLInputElement).focus();
        return;
      }

      clearError();
      isSubmitting = true;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Unlocking Scorecard...';
      }

      const result = computeDiagnosticResult();
      const payload = {
        name,
        company,
        email,
        website,
        notes: result.notes.slice(0, 1000),
        totalScore: result.totalScore,
        tier: result.tier.label,
        ciScore: result.ciScore,
        ciLabel: result.ciLabel,
        gateScore: result.gateScore,
        gateLabel: result.gateLabel,
        wcagScore: result.wcagScore,
        wcagLabel: result.wcagLabel,
        primaryFriction: result.primaryFriction,
        teamScale: result.teamScale,
        weeklyHoursLost: result.weeklyHoursLost,
        recommendedSprint: result.recommendedSprint,
      };

      let submissionFailed = false;

      try {
        const response = await fetch('/api/diagnostic', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (response.status === 400) {
          let errMsg = 'Please verify your contact details and try again.';
          try {
            const errJson = (await response.json()) as { error?: string };
            if (errJson?.error) errMsg = errJson.error;
          } catch {
            // Keep default validation error message
          }
          showError(errMsg);
          isSubmitting = false;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Unlock My QA Scorecard →';
          }
          return;
        }

        if (!response.ok) {
          submissionFailed = true;
        }
      } catch {
        // Gracefully fall through and unlock scorecard if local dev or network blocks /api/diagnostic
        submissionFailed = true;
      }

      isSubmitting = false;
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Unlock My QA Scorecard →';
      }
      unlockResultsView(result, submissionFailed);
    });

    copySummaryBtn?.addEventListener('click', async () => {
      if (!lastFormattedSummary) return;

      let copied = false;
      try {
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
          await navigator.clipboard.writeText(lastFormattedSummary);
          copied = true;
        }
      } catch {
        copied = false;
      }

      if (!copied) {
        try {
          const textarea = document.createElement('textarea');
          textarea.value = lastFormattedSummary;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          copied = document.execCommand('copy');
          document.body.removeChild(textarea);
        } catch {
          copied = false;
        }
      }

      if (copied) {
        copySummaryBtn.textContent = 'Copied Summary ✓';
        if (copyStatus) {
          copyStatus.textContent = 'Diagnostic summary copied to clipboard.';
        }
      } else if (copyStatus) {
        copyStatus.textContent = 'Unable to access clipboard. Use the email link to share your report.';
      }
    });

    calCta?.addEventListener('click', () => {
      trackAnalyticsEvent('qa_diagnostic_cta_click', {
        destination: 'cal_15min',
      });
    });

    resetBtn?.addEventListener('click', () => {
      form.reset();
      clearAllFieldErrors();
      syncNotice?.classList.add('hidden');
      lastFormattedSummary = '';
      if (copySummaryBtn) {
        copySummaryBtn.textContent = 'Copy Diagnostic Summary';
      }
      if (copyStatus) {
        copyStatus.textContent = '';
      }
      currentStep = 1;
      isResultsUnlocked = false;
      isSubmitting = false;
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Unlock My QA Scorecard →';
      }
      resultsPanel.classList.add('hidden');
      form.classList.remove('hidden');
      progressHeader?.classList.remove('hidden');
      updateStepUI();
    });

    updateStepUI();
  }

  initQaDiagnostic();
</script>
