            id="diag-reset-btn"
            class="text-xs font-mono text-zinc-600 hover:text-zinc-950 underline underline-offset-4 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 rounded px-2 py-1 self-start sm:self-center cursor-pointer"
