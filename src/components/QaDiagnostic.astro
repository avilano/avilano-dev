              class="inline-flex items-center justify-center px-4 py-3 rounded-md text-xs sm:text-sm font-semibold border border-zinc-300 bg-white text-zinc-900 hover:border-zinc-950 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 cursor-pointer"
            >
