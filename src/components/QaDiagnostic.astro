            </div>
            <div class="w-full h-2.5 rounded-full bg-zinc-200 overflow-hidden" role="progressbar" aria-label="Pre-Merge Release Gating score" aria-valuemin="0" aria-valuemax="35" aria-valuenow="0" id="res-gate-track">
              <div id="res-gate-bar" class="h-full bg-indigo-600 rounded-full transition-all duration-500" style="width: 0%"></div>
