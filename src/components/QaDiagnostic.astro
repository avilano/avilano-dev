<section
  id="qa-diagnostic"
  class="py-20 md:py-28 relative bg-white border-b border-zinc-200 scroll-reveal"
  aria-labelledby="qa-diagnostic-heading"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="text-left max-w-2xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md border border-sky-200 bg-sky-50 text-sky-800 text-xs font-mono font-semibold mb-3">
        <span class="w-2 h-2 rounded-full bg-sky-700" aria-hidden="true"></span>
        <span>2-Minute Interactive Assessment</span>
      </div>
      <h2 id="qa-diagnostic-heading" class="text-3xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
        QA &amp; CI Pipeline Readiness Diagnostic
      </h2>
      <p class="mt-3 text-zinc-600 text-sm sm:text-base leading-relaxed">
        Score your release pipeline across CI speed, pre-merge gating, and WCAG 2.1 AA / AI safety gates. Get an instant 100-point scorecard, weekly engineering hours lost, and a tailored remediation path.
      </p>
    </div>

    <!-- Main Diagnostic Card -->
    <div class="rounded-xl border border-zinc-200 bg-zinc-50/80 p-6 sm:p-10 shadow-sm overflow-hidden">
      <!-- Progress Bar Header (hidden on results view) -->
      <div id="diag-progress-header" class="mb-8 pb-6 border-b border-zinc-200">
        <div class="flex items-center justify-between text-xs font-mono mb-3">
          <span id="diag-step-label" class="text-sky-700 font-semibold uppercase tracking-wider">
            Step 1 of 5: CI Speed &amp; Determinism
          </span>
          <span id="diag-step-percent" class="text-zinc-600 font-semibold">20%</span>
        </div>
        <div
          class="w-full h-2 rounded-full bg-zinc-200 overflow-hidden"
          role="progressbar"
          aria-label="Diagnostic completion progress"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="20"
          id="diag-progress-bar-track"
        >
          <div
            id="diag-progress-bar-fill"
            class="h-full bg-zinc-950 rounded-full transition-all duration-300"
            style="width: 20%"
          ></div>
        </div>
      </div>

      <!-- Validation / Status Live Region -->
      <div
        id="diag-error"
        role="alert"
        aria-live="assertive"
        class="hidden mb-6 p-3.5 rounded-lg border border-rose-300 bg-rose-50 text-rose-800 text-xs sm:text-sm font-medium"
      ></div>

      <!-- Multi-Step Form -->
      <form id="diag-form" novalidate>
        <!-- STEP 1: CI Speed & Determinism (0-40 pts) -->
        <div class="diag-step" data-step="1">
          <fieldset>
            <legend class="text-lg sm:text-xl font-bold text-zinc-950 mb-2">
              How long does your full E2E / CI suite take, and how often do flakes block merges?
            </legend>
            <p class="text-xs sm:text-sm text-zinc-600 mb-6">
              Measures CI speed, determinism, and developer merge friction (up to 40 points).
            </p>
            <div class="grid grid-cols-1 gap-3">
              <label class="block cursor-pointer">
                <input type="radio" name="ci_speed" value="40" data-label="< 10 min, rarely flakes" class="sr-only peer" />
                <div class="p-4 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-zinc-950">&lt; 10 min, rarely flakes</span>
                  <span class="text-xs font-mono text-zinc-600 shrink-0">Fast &amp; Deterministic</span>
                </div>
              </label>

              <label class="block cursor-pointer">
                <input type="radio" name="ci_speed" value="24" data-label="10-30 min, occasional reruns" class="sr-only peer" />
                <div class="p-4 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-zinc-950">10-30 min, occasional reruns</span>
                  <span class="text-xs font-mono text-zinc-600 shrink-0">Moderate Drag</span>
                </div>
              </label>

              <label class="block cursor-pointer">
                <input type="radio" name="ci_speed" value="8" data-label="30-60+ min or frequent flaky failures" class="sr-only peer" />
                <div class="p-4 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-zinc-950">30-60+ min or frequent flaky failures</span>
                  <span class="text-xs font-mono text-zinc-600 shrink-0">High Merge Drag</span>
                </div>
              </label>

              <label class="block cursor-pointer">
                <input type="radio" name="ci_speed" value="4" data-label="No automated E2E suite yet" class="sr-only peer" />
                <div class="p-4 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-zinc-950">No automated E2E suite yet</span>
                  <span class="text-xs font-mono text-zinc-600 shrink-0">Greenfield</span>
                </div>
              </label>
            </div>
          </fieldset>
        </div>

        <!-- STEP 2: Pre-Merge Release Gating (0-35 pts) -->
        <div class="diag-step hidden" data-step="2">
          <fieldset>
            <legend class="text-lg sm:text-xl font-bold text-zinc-950 mb-2">
              How are critical user flows verified before merging to production?
            </legend>
            <p class="text-xs sm:text-sm text-zinc-600 mb-6">
              Measures regression protection before code reaches production (up to 35 points).
            </p>
            <div class="grid grid-cols-1 gap-3">
              <label class="block cursor-pointer">
                <input type="radio" name="release_gate" value="35" data-label="Automated E2E PR gate (sharded)" class="sr-only peer" />
                <div class="p-4 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-zinc-950">Automated E2E PR gate (sharded)</span>
                  <span class="text-xs font-mono text-zinc-600 shrink-0">Pre-Merge Gate</span>
                </div>
              </label>

              <label class="block cursor-pointer">
                <input type="radio" name="release_gate" value="20" data-label="Automated suite runs nightly / post-merge only" class="sr-only peer" />
                <div class="p-4 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-zinc-950">Automated suite runs nightly / post-merge only</span>
                  <span class="text-xs font-mono text-zinc-600 shrink-0">Delayed Feedback</span>
                </div>
              </label>

              <label class="block cursor-pointer">
                <input type="radio" name="release_gate" value="10" data-label="Manual QA / spot-checks before release" class="sr-only peer" />
                <div class="p-4 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-zinc-950">Manual QA / spot-checks before release</span>
                  <span class="text-xs font-mono text-zinc-600 shrink-0">Manual Bottleneck</span>
                </div>
              </label>

              <label class="block cursor-pointer">
                <input type="radio" name="release_gate" value="5" data-label="Unit tests only / ship and monitor" class="sr-only peer" />
                <div class="p-4 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-zinc-950">Unit tests only / ship and monitor</span>
                  <span class="text-xs font-mono text-zinc-600 shrink-0">High Regression Risk</span>
                </div>
              </label>
            </div>
          </fieldset>
        </div>

        <!-- STEP 3: WCAG 2.1 AA & AI Safety Gates (0-25 pts) -->
        <div class="diag-step hidden" data-step="3">
          <fieldset>
            <legend class="text-lg sm:text-xl font-bold text-zinc-950 mb-2">
              How are WCAG 2.1 AA accessibility or AI/LLM outputs verified in CI?
            </legend>
            <p class="text-xs sm:text-sm text-zinc-600 mb-6">
              Measures automated compliance and non-deterministic output guardrails (up to 25 points).
            </p>
            <div class="grid grid-cols-1 gap-3">
              <label class="block cursor-pointer">
                <input type="radio" name="wcag_ai" value="25" data-label="Automated CI gates (@axe-core / LLM evals)" class="sr-only peer" />
                <div class="p-4 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-zinc-950">Automated CI gates (@axe-core / LLM evals)</span>
                  <span class="text-xs font-mono text-zinc-600 shrink-0">Continuous Guardrails</span>
                </div>
              </label>

              <label class="block cursor-pointer">
                <input type="radio" name="wcag_ai" value="12" data-label="Periodic manual audits / ad-hoc checks" class="sr-only peer" />
                <div class="p-4 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-zinc-950">Periodic manual audits / ad-hoc checks</span>
                  <span class="text-xs font-mono text-zinc-600 shrink-0">Drift Between Audits</span>
                </div>
              </label>

              <label class="block cursor-pointer">
                <input type="radio" name="wcag_ai" value="4" data-label="Not tested systematically yet" class="sr-only peer" />
                <div class="p-4 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors flex items-center justify-between gap-4">
                  <span class="text-sm font-medium text-zinc-950">Not tested systematically yet</span>
                  <span class="text-xs font-mono text-zinc-600 shrink-0">Unverified Exposure</span>
                </div>
              </label>
            </div>
          </fieldset>
        </div>

        <!-- STEP 4: Routing & ROI -->
        <div class="diag-step hidden" data-step="4">
          <div class="space-y-6">
            <fieldset>
              <legend class="text-base sm:text-lg font-bold text-zinc-950 mb-3">
                Primary Friction Point
              </legend>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <label class="block cursor-pointer">
                  <input type="radio" name="primary_friction" value="Flaky tests blocking PR merges" class="sr-only peer" />
                  <div class="p-3.5 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors">
                    <span class="text-sm font-medium text-zinc-950">Flaky tests blocking PR merges</span>
                  </div>
                </label>

                <label class="block cursor-pointer">
                  <input type="radio" name="primary_friction" value="Slow CI / Cypress or Selenium" class="sr-only peer" />
                  <div class="p-3.5 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors">
                    <span class="text-sm font-medium text-zinc-950">Slow CI / Cypress or Selenium</span>
                  </div>
                </label>

                <label class="block cursor-pointer">
                  <input type="radio" name="primary_friction" value="WCAG 2.1 AA / ADA Title II gaps" class="sr-only peer" />
                  <div class="p-3.5 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors">
                    <span class="text-sm font-medium text-zinc-950">WCAG 2.1 AA / ADA Title II gaps</span>
                  </div>
                </label>

                <label class="block cursor-pointer">
                  <input type="radio" name="primary_friction" value="Unreliable AI/LLM agent outputs" class="sr-only peer" />
                  <div class="p-3.5 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors">
                    <span class="text-sm font-medium text-zinc-950">Unreliable AI/LLM agent outputs</span>
                  </div>
                </label>
              </div>
            </fieldset>

            <fieldset>
              <legend class="text-base sm:text-lg font-bold text-zinc-950 mb-3">
                Engineering Scale (Active Engineers)
              </legend>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <label class="block cursor-pointer">
                  <input type="radio" name="team_scale" value="1-10" class="sr-only peer" />
                  <div class="p-3 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors text-center">
                    <span class="text-sm font-mono font-semibold text-zinc-950">1-10</span>
                  </div>
                </label>

                <label class="block cursor-pointer">
                  <input type="radio" name="team_scale" value="11-40" class="sr-only peer" />
                  <div class="p-3 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors text-center">
                    <span class="text-sm font-mono font-semibold text-zinc-950">11-40</span>
                  </div>
                </label>

                <label class="block cursor-pointer">
                  <input type="radio" name="team_scale" value="41-100" class="sr-only peer" />
                  <div class="p-3 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors text-center">
                    <span class="text-sm font-mono font-semibold text-zinc-950">41-100</span>
                  </div>
                </label>

                <label class="block cursor-pointer">
                  <input type="radio" name="team_scale" value="100+" class="sr-only peer" />
                  <div class="p-3 rounded-lg border border-zinc-200 bg-white hover:border-zinc-400 peer-checked:border-zinc-950 peer-checked:bg-zinc-950/5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-600 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white transition-colors text-center">
                    <span class="text-sm font-mono font-semibold text-zinc-950">100+</span>
                  </div>
                </label>
              </div>
            </fieldset>

            <div>
              <label for="diag-notes" class="block text-sm font-semibold text-zinc-900 mb-2">
                Any details on your stack or release bottleneck? (Optional)
              </label>
              <textarea
                id="diag-notes"
                name="stack_notes"
                rows="3"
                maxlength="1000"
                placeholder="e.g. Next.js + GitHub Actions, 45-min Cypress suite, upcoming VPAT 2.5 audit..."
                class="w-full rounded-lg border border-zinc-300 bg-white px-4 py-3 text-sm text-zinc-950 placeholder:text-zinc-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:border-brand-600"
              ></textarea>
            </div>
          </div>
        </div>

        <!-- STEP 5: Unlock Scorecard (Editorial Light Form) -->
        <div class="diag-step hidden" data-step="5">
          <div class="mb-6">
            <h3 class="text-lg sm:text-xl font-bold text-zinc-950 mb-2">
              Unlock Your QA Readiness Report
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
              Review your selections below and enter your details to unlock your 100-point scorecard, estimated weekly engineering hours lost, and recommended remediation sprint.
            </p>
          </div>

          <!-- Compact Final Review Summary -->
          <div
            id="diag-review-summary"
            class="mb-6 p-4 rounded-lg border border-zinc-200 bg-white"
            aria-label="Diagnostic selection summary"
          >
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-sky-700">
                Your Diagnostic Summary
              </span>
              <span class="text-xs font-mono text-zinc-600">
                4 of 4 answered
              </span>
            </div>
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 text-xs">
              <div>
                <dt class="font-mono text-zinc-600 uppercase tracking-wide text-[11px]">CI Speed</dt>
                <dd id="review-ci-speed" class="text-zinc-950 font-medium mt-0.5">Not selected</dd>
              </div>
              <div>
                <dt class="font-mono text-zinc-600 uppercase tracking-wide text-[11px]">Release Gate</dt>
                <dd id="review-release-gate" class="text-zinc-950 font-medium mt-0.5">Not selected</dd>
              </div>
              <div>
                <dt class="font-mono text-zinc-600 uppercase tracking-wide text-[11px]">WCAG / AI Gates</dt>
                <dd id="review-wcag-ai" class="text-zinc-950 font-medium mt-0.5">Not selected</dd>
              </div>
              <div>
                <dt class="font-mono text-zinc-600 uppercase tracking-wide text-[11px]">Friction &amp; Scale</dt>
                <dd id="review-friction-scale" class="text-zinc-950 font-medium mt-0.5">Not selected</dd>
              </div>
            </dl>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="diag-name" class="block text-sm font-semibold text-zinc-900 mb-1.5">
                  Name <span class="text-sky-700" aria-hidden="true">*</span>
                </label>
                <input
                  id="diag-name"
                  name="name"
                  type="text"
                  required
                  maxlength="120"
                  autocomplete="name"
                  placeholder="Alex Rivera"
                  class="w-full rounded-lg border border-zinc-300 bg-white px-4 py-3 text-sm text-zinc-950 placeholder:text-zinc-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:border-brand-600 transition-colors"
                />
                <p
                  id="diag-name-error"
                  role="alert"
                  class="hidden mt-1.5 flex items-start gap-1.5 text-xs font-medium text-rose-700"
                >
                  <svg class="w-4 h-4 shrink-0 mt-0.5 text-rose-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                  <span class="diag-field-error-text"></span>
                </p>
              </div>

              <div>
                <label for="diag-company" class="block text-sm font-semibold text-zinc-900 mb-1.5">
                  Company <span class="text-sky-700" aria-hidden="true">*</span>
                </label>
                <input
                  id="diag-company"
                  name="company"
                  type="text"
                  required
                  maxlength="120"
                  autocomplete="organization"
                  placeholder="Acme Engineering"
                  class="w-full rounded-lg border border-zinc-300 bg-white px-4 py-3 text-sm text-zinc-950 placeholder:text-zinc-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:border-brand-600 transition-colors"
                />
                <p
                  id="diag-company-error"
                  role="alert"
                  class="hidden mt-1.5 flex items-start gap-1.5 text-xs font-medium text-rose-700"
                >
                  <svg class="w-4 h-4 shrink-0 mt-0.5 text-rose-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                  <span class="diag-field-error-text"></span>
                </p>
              </div>
            </div>

            <div>
              <label for="diag-email" class="block text-sm font-semibold text-zinc-900 mb-1.5">
                Work Email <span class="text-sky-700" aria-hidden="true">*</span>
              </label>
              <input
                id="diag-email"
                name="email"
                type="email"
                required
                maxlength="254"
                autocomplete="email"
                placeholder="alex@company.com"
                class="w-full rounded-lg border border-zinc-300 bg-white px-4 py-3 text-sm text-zinc-950 placeholder:text-zinc-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:border-brand-600 transition-colors"
              />
              <p
                id="diag-email-error"
                role="alert"
                class="hidden mt-1.5 flex items-start gap-1.5 text-xs font-medium text-rose-700"
              >
                <svg class="w-4 h-4 shrink-0 mt-0.5 text-rose-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span class="diag-field-error-text"></span>
              </p>
            </div>

            <!-- Visually-hidden honeypot field -->
            <div class="sr-only" aria-hidden="true">
              <label for="diag-website">Website</label>
              <input
                id="diag-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
