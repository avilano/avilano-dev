            <div class="w-full h-2.5 rounded-full bg-zinc-200 overflow-hidden" role="progressbar" aria-label="WCAG 2.1 AA and AI Safety Gates score" aria-valuemin="0" aria-valuemax="25" aria-valuenow="0" id="res-wcag-track">
