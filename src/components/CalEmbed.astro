---
---
<section id="book-call" class="py-20 md:py-28 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="text-left max-w-2xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-mono font-medium mb-3">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>2 Sprint Slots Open This Month</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Book a 15-Minute Architecture Fit Call
      </h2>
      <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
        Zero sales pitch. Let’s look at your current test suite, diagnose your release bottlenecks or WCAG compliance timeline, and see if our async model fits.
      </p>
    </div>

    <!-- Booking Container -->
    <div class="rounded-2xl border border-dark-700 bg-dark-900/90 p-6 sm:p-10 shadow-2xl overflow-hidden">
      
      <!-- Qualification Criteria Header -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pb-8 mb-8 border-b border-dark-800 text-xs text-slate-300">
        <div class="p-4 rounded-xl bg-dark-800/60 border border-dark-700/60">
          <span class="font-mono text-brand-400 font-bold block mb-1">01. Tech Stack</span>
          <p class="text-slate-400">Web applications built with TypeScript, React, Next.js, or Vue.</p>
        </div>
        <div class="p-4 rounded-xl bg-dark-800/60 border border-dark-700/60">
          <span class="font-mono text-brand-400 font-bold block mb-1">02. Acute Need</span>
          <p class="text-slate-400">Flaky CI pipelines, slow releases, or upcoming WCAG 2.1 AA mandates.</p>
        </div>
        <div class="p-4 rounded-xl bg-dark-800/60 border border-dark-700/60">
          <span class="font-mono text-brand-400 font-bold block mb-1">03. Working Format</span>
          <p class="text-slate-400">Choosing between a 21-Day Sprint or the $5,495/mo Async Retainer.</p>
        </div>
      </div>

      <!-- Live Cal.com Inline Embed Container -->
      <div class="w-full min-h-[550px] rounded-xl overflow-hidden bg-dark-950 flex flex-col items-center justify-center p-2 relative">
        
        <!-- Cal.com target container -->
        <div id="my-cal-inline" class="w-full h-full min-h-[550px]"></div>

        <!-- Fallback Button if user hasn't set up Cal.com username yet -->
        <div class="mt-4 text-center pb-4">
          <a
            href="https://cal.com/avilano/15min"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-xs font-semibold text-white bg-brand-500 hover:bg-brand-600 transition-colors shadow-sm"
          >
            <span>Open in Cal.com Directly</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
          <p class="text-[11px] font-mono text-slate-500 mt-3">
            Prefer email? Send your repository or questions directly to <a href="mailto:contact@avilano.dev" class="text-brand-400 hover:underline">contact@avilano.dev</a>
          </p>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- Official Cal.com Inline Embed Script -->
<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        typeof namespace === "string" ? (cal.ns[namespace] = api) && p(api, ar) : p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", { origin: "https://app.cal.com" });

  Cal("inline", {
    elementOrSelector: "#my-cal-inline",
    config: { layout: "month_view" },
    calLink: "avilano/15min",
  });

  Cal("ui", {
    theme: "dark",
    cssVarsPerTheme: {
      dark: { "cal-brand": "#0ea5e9" }
    },
    hideEventTypeDetails: false,
    layout: "month_view"
  });
</script>
