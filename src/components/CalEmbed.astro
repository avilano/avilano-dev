---
---
<section id="book-call" class="py-20 md:py-28 relative scroll-reveal">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="text-left max-w-2xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-mono font-medium mb-3">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>2 Sprint Slots Open This Month</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Book a 15-Minute Architecture Fit Call
      </h2>
      <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
        Zero sales pitch. Let’s look at your current test suite, diagnose your release bottlenecks or WCAG compliance timeline, and see if our async model fits.
      </p>
    </div>

    <!-- Booking Container -->
    <div class="rounded-2xl border border-dark-700 bg-dark-900/90 p-6 sm:p-10 shadow-2xl overflow-hidden">
      
      <!-- Qualification Criteria Header -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pb-8 mb-8 border-b border-dark-800 text-xs text-slate-300">
        <div class="p-4 rounded-xl bg-dark-800/60 border border-dark-700/60">
          <span class="font-mono text-brand-400 font-bold block mb-1">01. Tech Stack</span>
          <p class="text-slate-400">Web applications built with TypeScript, React, Next.js, or Vue.</p>
        </div>
        <div class="p-4 rounded-xl bg-dark-800/60 border border-dark-700/60">
          <span class="font-mono text-brand-400 font-bold block mb-1">02. Acute Need</span>
          <p class="text-slate-400">Flaky CI pipelines, slow releases, or upcoming WCAG 2.1 AA mandates.</p>
        </div>
        <div class="p-4 rounded-xl bg-dark-800/60 border border-dark-700/60">
          <span class="font-mono text-brand-400 font-bold block mb-1">03. Working Format</span>
          <p class="text-slate-400">Choosing between a 21-Day Sprint or the $5,495/mo Async Retainer.</p>
        </div>
      </div>

      <!-- Live Cal.com Inline Embed Container -->
      <div class="w-full min-h-[640px] rounded-xl overflow-hidden bg-[#080c14] border border-dark-700/70 flex flex-col items-center justify-center p-2 sm:p-4 relative">
        
        <!-- Lazy Load Skeleton / Placeholder -->
        <div id="cal-loading-placeholder" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-[#080c14] z-10 transition-opacity duration-300">
          <div class="w-12 h-12 rounded-full border-2 border-brand-400/30 border-t-brand-400 animate-spin mb-4"></div>
          <h3 class="text-base font-bold text-white mb-2">15-Minute Architecture Fit Call</h3>
          <p class="text-xs text-slate-400 max-w-sm mb-6">
            Connecting to live availability calendar (Google Meet • CST / Central Time)...
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <button
              id="load-cal-btn"
              type="button"
              class="px-5 py-2.5 rounded-lg text-xs font-bold text-dark-900 bg-white hover:bg-slate-100 transition-colors shadow-sm"
            >
              Load Interactive Calendar
            </button>
            <a
              href="https://cal.com/avilano/15min"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-lg text-xs font-semibold text-slate-200 border border-dark-600 bg-dark-800 hover:bg-dark-700 transition-colors"
            >
              Open Direct in New Tab ↗
            </a>
          </div>
        </div>

        <!-- Cal.com target container -->
        <div id="my-cal-inline" style="width:100%;min-height:640px;height:100%;overflow:auto"></div>

        <!-- Direct Link / Email Fallback -->
        <div class="mt-4 text-center pb-4 pt-2">
          <p class="text-xs text-slate-400">
            Trouble seeing the calendar? <a href="https://cal.com/avilano/15min" target="_blank" rel="noopener noreferrer" class="text-brand-400 underline font-medium hover:text-brand-300">Open Cal.com in a new tab</a>
          </p>
          <p class="text-[11px] font-mono text-slate-400 mt-2">
            Prefer email? Send your repository directly to <a href="mailto:contact@avilano.dev" class="text-slate-200 hover:underline">contact@avilano.dev</a>
          </p>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- Official Cal.com Embed with Lazy-Loading Observer (100% Core Web Vitals & Zero Initial Blocking) -->
<script is:inline>
  (function () {
    let calInitialized = false;

    function initCal() {
      if (calInitialized) return;
      calInitialized = true;

      (function (C, A, L) {
        let p = function (a, ar) { a.q.push(ar); };
        let d = C.document;
        C.Cal = C.Cal || function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            typeof namespace === "string" ? (cal.ns[namespace] = api) && p(api, ar) : p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(window, "https://app.cal.com/embed/embed.js", "init");

      Cal("init", { origin: "https://app.cal.com" });

      Cal("inline", {
        elementOrSelector: "#my-cal-inline",
        config: { layout: "column_view" },
        calLink: "avilano/15min",
      });

      Cal("ui", {
        theme: "dark",
        cssVarsPerTheme: {
          dark: {
            "cal-brand": "#0ea5e9",
            "cal-text": "#f8fafc",
            "cal-text-muted": "#94a3b8",
            "cal-bg": "#080c14",
            "cal-bg-emphasis": "#0f172a",
            "cal-border": "#1e293b",
            "cal-border-subtle": "#1e293b"
          }
        },
        hideEventTypeDetails: true,
        layout: "column_view"
      });

      // Hide placeholder once Cal renders
      setTimeout(() => {
        const ph = document.getElementById("cal-loading-placeholder");
        if (ph) {
          ph.style.opacity = "0";
          setTimeout(() => ph.style.display = "none", 300);
        }
      }, 1200);
    }

    // Lazy load when #book-call approaches viewport
    const section = document.getElementById("book-call");
    if (section && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            initCal();
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: "350px 0px" });
      observer.observe(section);
    }

    // Fallback: immediate trigger on manual button click or hash navigation
    const loadBtn = document.getElementById("load-cal-btn");
    if (loadBtn) loadBtn.addEventListener("click", initCal);

    if (window.location.hash === "#book-call") {
      initCal();
    }
  })();
</script>
