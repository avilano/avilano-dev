---
import { PRIMARY_NAV_LINKS, HEADER_CTA, isCurrentPage } from '../data/navigation';

const currentPath = Astro.url.pathname;
---
<header class="site-header sticky top-0 z-40 w-full border-b border-zinc-200 bg-white/90 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600">
      <div class="w-8 h-8 rounded-md bg-zinc-950 flex items-center justify-center font-mono font-bold text-white text-sm group-hover:bg-zinc-800 transition-colors">
        a.
      </div>
      <span class="font-mono font-semibold tracking-tight text-zinc-950 group-hover:text-sky-700 transition-colors">
        avilano<span class="text-sky-700">.dev</span>
      </span>
    </a>

    <!-- Single semantic Primary Navigation landmark for both mobile popover and desktop inline -->
    <nav class="site-nav flex items-center md:flex-1 md:justify-center order-3 md:order-2" aria-label="Primary">
      <button
        type="button"
        class="menu-button inline-flex items-center justify-center w-11 h-11 rounded-md border border-zinc-200 bg-white text-zinc-800 hover:text-zinc-950 hover:border-zinc-400 transition-colors cursor-pointer"
        popovertarget="site-menu"
        popovertargetaction="toggle"
        aria-controls="site-menu"
        aria-expanded="false"
      >
        <svg class="menu-icon-open w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <svg class="menu-icon-close w-5 h-5 shrink-0 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
        <span class="sr-only">Menu</span>
      </button>

      <ul id="site-menu" class="site-menu" popover="auto">
        {PRIMARY_NAV_LINKS.map((link) => {
          const active = isCurrentPage(link.href, currentPath);
          return (
            <li>
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                class="site-menu-link"
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Header CTA -->
    <div class="flex items-center shrink-0 order-2 md:order-3">
      <a
        href={HEADER_CTA.href}
        class="inline-flex items-center justify-center min-h-[44px] sm:min-h-0 px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold rounded-md text-white bg-zinc-950 hover:bg-zinc-800 transition-colors whitespace-nowrap shadow-sm"
      >
        <span class="sm:hidden">{HEADER_CTA.shortLabel}</span>
        <span class="hidden sm:inline">{HEADER_CTA.fullLabel}</span>
      </a>
    </div>
  </div>
</header>

<style is:global>
  .site-header .menu-button {
    anchor-name: --menu-button;
  }

  .site-header .menu-button[aria-expanded="true"] .menu-icon-open {
    display: none;
  }

  .site-header .menu-button[aria-expanded="true"] .menu-icon-close {
    display: block;
  }

  /* Narrow layout: top-layer native popover anchored below the menu button */
  .site-header .site-menu {
    position: fixed;
    inset: auto;
    inset-block-start: 4.5rem;
    inset-block-start: anchor(--menu-button bottom);
    inset-inline-end: 1rem;
    inline-size: min(85dvw, 20rem);
    max-inline-size: calc(100dvw - 2rem);
    block-size: fit-content;
    max-block-size: calc(100dvh - 5.5rem);
    margin: 0;
    margin-block-start: 0.5rem;
    padding: 0.5rem;
    overflow: auto;
    list-style: none;
    border-radius: 0.5rem;
    border: 1px solid #e4e4e7;
    background-color: #ffffff;
    color: #09090b;
    box-shadow: 0 20px 45px rgba(9, 9, 11, 0.14);
  }

  .site-header .site-menu:not(:is(:popover-open, .\:popover-open)) {
    display: none;
  }

  .site-header .site-menu:is(:popover-open, .\:popover-open) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .site-header .site-menu::backdrop {
    background: rgba(9, 9, 11, 0.35);
  }

  .site-header .site-menu-link {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: 0.875rem;
    padding-block: 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #3f3f46;
    text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .site-header .site-menu-link:hover {
    color: #09090b;
    background-color: #f4f4f5;
  }

  .site-header .site-menu-link[aria-current="page"] {
    color: #09090b;
    font-weight: 600;
    background-color: #f4f4f5;
    border-inline-start: 3px solid #0284c7;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header .site-menu {
      opacity: 0;
      translate: 0 -0.5rem;
      transition: opacity 150ms ease, translate 150ms ease, display 150ms ease, overlay 150ms ease;
      transition-behavior: allow-discrete;
    }

    .site-header .site-menu:is(:popover-open, .\:popover-open) {
      opacity: 1;
      translate: 0 0;
    }

    @starting-style {
      .site-header .site-menu:is(:popover-open, .\:popover-open) {
        opacity: 0;
        translate: 0 -0.5rem;
      }
    }
  }

  /* Wide layout (>= 768px): inline navigation with zero CLS */
  @media (min-width: 768px) {
    .site-header .menu-button {
      display: none;
    }

    .site-header .site-menu,
    .site-header .site-menu:not(:is(:popover-open, .\:popover-open)) {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 1.75rem;
      inline-size: auto;
      max-inline-size: none;
      block-size: auto;
      max-block-size: none;
      margin: 0;
      padding: 0;
      overflow: visible;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      opacity: 1;
      translate: none;
    }

    .site-header .site-menu::backdrop {
      display: none;
    }

    .site-header .site-menu-link {
      min-block-size: auto;
      padding: 0.25rem 0;
      border-radius: 0.25rem;
      font-size: 0.875rem;
      color: #52525b;
      background: transparent;
    }

    .site-header .site-menu-link:hover {
      background: transparent;
      color: #09090b;
    }

    .site-header .site-menu-link[aria-current="page"] {
      color: #09090b;
      background: transparent;
      border-inline-start: 0;
      text-decoration: underline;
      text-decoration-color: #0284c7;
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
  }

  @media (forced-colors: active) {
    .site-header .site-menu {
      border: 1px solid CanvasText;
    }

    .site-header .site-menu-link[aria-current="page"] {
      border-inline-start-color: Highlight;
      text-decoration: underline;
    }
  }
</style>

<script>
  const menu = document.getElementById('site-menu');
  const button = document.querySelector<HTMLButtonElement>('.site-header .menu-button');

  if (menu && button) {
    const desktopQuery = window.matchMedia('(min-width: 768px)');
    const supportsPopover = Object.hasOwn(HTMLElement.prototype, 'popover');

    const syncLayout = () => {
      if (desktopQuery.matches) {
        if (supportsPopover && menu.matches(':popover-open')) {
          menu.hidePopover();
        }
        menu.classList.remove(':popover-open');
        menu.removeAttribute('popover');
        button.setAttribute('aria-expanded', 'false');
      } else {
        menu.setAttribute('popover', 'auto');
      }
    };

    syncLayout();
    desktopQuery.addEventListener('change', syncLayout);

    if (supportsPopover) {
      menu.addEventListener('toggle', (event) => {
        const toggleEvent = event as ToggleEvent;
        button.setAttribute('aria-expanded', String(toggleEvent.newState === 'open'));
      });
    } else {
      button.addEventListener('click', () => {
        const isOpen = menu.classList.toggle(':popover-open');
        button.setAttribute('aria-expanded', String(isOpen));
      });
    }

    menu.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target?.closest('a')) return;
      if (supportsPopover && menu.hasAttribute('popover') && menu.matches(':popover-open')) {
        menu.hidePopover();
      } else if (!supportsPopover) {
        menu.classList.remove(':popover-open');
        button.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
