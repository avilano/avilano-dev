<!--
  Quantified Proof & Outcomes Strip (R1).
  Note: Replace or augment the stack bar below with verified client logos
  or attributed CTO/Staff Engineer quotes when ready for publication.
-->
<section aria-label="Proven Engineering Outcomes" class="bg-white border-b border-zinc-200 py-10 md:py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
      <span class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-700">
        Proven in Production CI
      </span>
      <span class="font-mono text-xs text-zinc-600">
        Measured across enterprise frontend &amp; compliance engagements
      </span>
    </div>

    <dl class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-5 rounded-lg border border-zinc-200 bg-zinc-50/70">
        <dt class="text-xs font-mono uppercase tracking-wider text-zinc-600">
          Tests Migrated to Playwright
        </dt>
        <dd class="mt-1.5 text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-950 font-mono">
          200+
        </dd>
        <p class="mt-2 text-xs text-zinc-600 leading-relaxed">
          Legacy Cypress &amp; Selenium suites converted to deterministic TypeScript specs with zero-downtime dual-run cutovers.
        </p>
      </div>

      <div class="p-5 rounded-lg border border-zinc-200 bg-zinc-50/70">
        <dt class="text-xs font-mono uppercase tracking-wider text-zinc-600">
          Sharded CI Gate Runtime
        </dt>
        <dd class="mt-1.5 text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-950 font-mono">
          &lt; 3 min
        </dd>
        <p class="mt-2 text-xs text-zinc-600 leading-relaxed">
          Pre-merge GitHub Actions sharding with API storageState auth caching (&lt;50ms) and zero manual reruns.
        </p>
      </div>

      <div class="p-5 rounded-lg border border-zinc-200 bg-zinc-50/70">
        <dt class="text-xs font-mono uppercase tracking-wider text-zinc-600">
          WCAG 2.1 AA Automated Coverage
        </dt>
        <dd class="mt-1.5 text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-950 font-mono">
          100%
        </dd>
        <p class="mt-2 text-xs text-zinc-600 leading-relaxed">
          Continuous @axe-core, W3C ARIA keyboard trap, and Guidepup screen-reader assertions wired into every PR.
        </p>
      </div>
    </dl>

    <!-- Stack & Standards Bar (swap in client logos/quotes here when available) -->
    <div class="mt-6 pt-5 border-t border-zinc-200 flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-zinc-600">
      <span class="text-zinc-950 font-semibold">Core Architecture Stack:</span>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5">
        <span>TypeScript</span>
        <span class="text-zinc-300" aria-hidden="true">/</span>
        <span>Playwright</span>
        <span class="text-zinc-300" aria-hidden="true">/</span>
        <span>React &amp; Next.js</span>
        <span class="text-zinc-300" aria-hidden="true">/</span>
        <span>GitHub Actions</span>
        <span class="text-zinc-300" aria-hidden="true">/</span>
        <span>ADA Title II &amp; VPAT 2.5</span>
      </div>
    </div>
