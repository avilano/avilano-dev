---
const fixtureCode = `// Automated WCAG 2.1 AA fixture wired into CI
export const test = base.extend<CustomFixtures>({
  checkA11y: async ({ page }, use, testInfo) => {
    const scanner = async (options = {}) => {
      const builder = new AxeBuilder({ page })
        .withTags(['wcag2a', 'wcag2aa', 'wcag21aa']);

      const results = await builder.analyze();
      const critical = results.violations.filter(
        (v) => ['critical', 'serious'].includes(v.impact)
      );

      // Attach full audit artifact to Playwright report
      await testInfo.attach('a11y-scan', {
        body: JSON.stringify(results.violations, null, 2),
        contentType: 'application/json',
      });

      expect(critical.length, 'WCAG Violations Found').toBe(0);
    };

    await use(scanner);
  },
});`;
---
<section id="standards" class="py-20 bg-[#F9F9F9] border-b border-zinc-200 scroll-reveal">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-left max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 font-mono text-xs text-sky-700 font-semibold mb-2 uppercase tracking-wider">
        <span>The Regulatory &amp; Engineering Reality</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
        Why Static PDF Audits &amp; Overlay Widgets Fail
      </h2>
      <p class="mt-4 text-zinc-600 text-base leading-relaxed">
        Enterprise procurement teams fail software with overlay widgets, and static 100-page audits expire the second your team pushes a new PR.
        We build a <strong class="text-zinc-950 font-semibold">permanent 3-layer automated testing defense</strong> wired directly into your GitHub Actions CI.
      </p>
    </div>

    <!-- Asymmetric Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Numbered 01 / 02 / 03 Pillars on Light Cards -->
      <div class="lg:col-span-6 space-y-4">
        <!-- Pillar 01 -->
        <div class="p-6 rounded-lg bg-white border border-zinc-200 hover:border-zinc-300 transition-colors">
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center gap-2 text-xs font-mono font-bold text-zinc-950 uppercase tracking-wider">
              <span class="px-1.5 py-0.5 rounded bg-zinc-950 text-white">01</span>
              <span>Static DOM &amp; Contrast</span>
            </span>
            <span class="text-xs font-mono text-sky-700 font-medium">@axe-core/playwright</span>
          </div>
          <h3 class="text-lg font-bold text-zinc-950 mb-1.5">Static DOM &amp; Contrast Verification</h3>
          <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
            Automated scans checking color contrast (4.5:1), missing form labels, invalid ARIA attributes, and unsemantic DOM nodes on every route transition. Fails CI on critical violations.
          </p>
          <div class="mt-3 pt-3 border-t border-zinc-100 text-[11px] font-mono text-zinc-600">
            Standards: WCAG 1.1.1, 1.4.3, 4.1.2
          </div>
        </div>

        <!-- Pillar 02 -->
        <div class="p-6 rounded-lg bg-white border border-zinc-200 hover:border-zinc-300 transition-colors">
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center gap-2 text-xs font-mono font-bold text-zinc-950 uppercase tracking-wider">
              <span class="px-1.5 py-0.5 rounded bg-zinc-950 text-white">02</span>
              <span>Keyboard &amp; Focus</span>
            </span>
            <span class="text-xs font-mono text-sky-700 font-medium">Playwright Keyboard</span>
          </div>
          <h3 class="text-lg font-bold text-zinc-950 mb-1.5">Deterministic Focus Traps &amp; Tab Order</h3>
          <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
            Tests sequential Tab navigation, visible focus indicators, skip-to-content links, and modal focus traps that restore focus to the trigger on Escape dismissal (W3C ARIA APG).
          </p>
          <div class="mt-3 pt-3 border-t border-zinc-100 text-[11px] font-mono text-zinc-600">
            Standards: WCAG 2.1.1, 2.1.2, 2.4.3
          </div>
        </div>

        <!-- Pillar 03 -->
        <div class="p-6 rounded-lg bg-white border border-zinc-200 hover:border-zinc-300 transition-colors">
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center gap-2 text-xs font-mono font-bold text-zinc-950 uppercase tracking-wider">
              <span class="px-1.5 py-0.5 rounded bg-zinc-950 text-white">03</span>
              <span>Screen Reader Audio</span>
            </span>
            <span class="text-xs font-mono text-sky-700 font-medium">Guidepup VoiceOver</span>
          </div>
          <h3 class="text-lg font-bold text-zinc-950 mb-1.5">Native Screen Reader Spoken Audio</h3>
          <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
            Drives native macOS VoiceOver programmatically to assert what visually impaired users actually hear. Verifies dynamic <code class="text-xs bg-zinc-100 border border-zinc-200 px-1.5 py-0.5 rounded text-sky-700 font-mono">aria-live</code> cart updates, notifications, and form error states.
          </p>
          <div class="mt-3 pt-3 border-t border-zinc-100 text-[11px] font-mono text-zinc-600">
            Standards: WCAG 4.1.3, US Section 508
          </div>
        </div>
      </div>

      <!-- Right Column: Dark Code Island Figure with Highlighted Assertion Lines & Copy Button -->
      <div class="lg:col-span-6">
        <figure class="rounded-lg border border-dark-700 bg-dark-900 shadow-xl overflow-hidden font-mono text-xs">
          <figcaption class="px-4 py-3 bg-dark-800 border-b border-dark-700 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 shrink-0" aria-hidden="true"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 shrink-0" aria-hidden="true"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 shrink-0" aria-hidden="true"></span>
              <span class="ml-2 text-slate-300 text-[11px] font-mono truncate">src/fixtures/base.fixture.ts</span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-sky-950/80 text-sky-400 border border-sky-800/60">
                TypeScript
              </span>
              <button
                type="button"
                id="copy-fixture-btn"
                data-code={fixtureCode}
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-[11px] font-mono font-medium bg-dark-700 text-slate-200 hover:bg-dark-600 hover:text-white border border-dark-600 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
              >
                <span id="copy-fixture-label">Copy</span>
              </button>
              <span id="copy-fixture-status" class="sr-only" aria-live="polite"></span>
            </div>
          </figcaption>

          <div class="p-5 overflow-x-auto bg-[#090d16] font-mono text-[12px] leading-relaxed select-text">
            <pre class="font-mono text-slate-200"><code><span class="text-slate-400 italic">// Automated WCAG 2.1 AA fixture wired into CI</span>
<span class="text-purple-400">export const</span> <span class="text-sky-300">test</span> <span class="text-slate-400">=</span> <span class="text-slate-200">base</span>.<span class="text-sky-400">extend</span>&lt;<span class="text-amber-300">CustomFixtures</span>&gt;(&#123;
  <span class="text-sky-300">checkA11y</span><span class="text-slate-400">:</span> <span class="text-purple-400">async</span> (&#123; <span class="text-orange-300">page</span> &#125;, <span class="text-orange-300">use</span>, <span class="text-orange-300">testInfo</span>) <span class="text-purple-400">=&gt;</span> &#123;
    <span class="text-purple-400">const</span> <span class="text-sky-300">scanner</span> <span class="text-slate-400">=</span> <span class="text-purple-400">async</span> (<span class="text-orange-300">options</span> <span class="text-slate-400">=</span> &#123;&#125;) <span class="text-purple-400">=&gt;</span> &#123;
<mark class="block -mx-5 px-5 border-l-2 border-brand-400 bg-brand-400/10 text-inherit">      <span class="text-purple-400">const</span> <span class="text-sky-300">builder</span> <span class="text-slate-400">=</span> <span class="text-purple-400">new</span> <span class="text-amber-300">AxeBuilder</span>(&#123; <span class="text-slate-200">page</span> &#125;)
        .<span class="text-sky-400">withTags</span>([<span class="text-emerald-300">'wcag2a'</span>, <span class="text-emerald-300">'wcag2aa'</span>, <span class="text-emerald-300">'wcag21aa'</span>]);</mark>

      <span class="text-purple-400">const</span> <span class="text-sky-300">results</span> <span class="text-slate-400">=</span> <span class="text-purple-400">await</span> <span class="text-sky-300">builder</span>.<span class="text-sky-400">analyze</span>();
      <span class="text-purple-400">const</span> <span class="text-sky-300">critical</span> <span class="text-slate-400">=</span> <span class="text-sky-300">results</span>.<span class="text-slate-200">violations</span>.<span class="text-sky-400">filter</span>(
        (<span class="text-orange-300">v</span>) <span class="text-purple-400">=&gt;</span> [<span class="text-emerald-300">'critical'</span>, <span class="text-emerald-300">'serious'</span>].<span class="text-sky-400">includes</span>(<span class="text-orange-300">v</span>.<span class="text-slate-200">impact</span>)
      );

      <span class="text-slate-400 italic">// Attach full audit artifact to Playwright report</span>
      <span class="text-purple-400">await</span> <span class="text-orange-300">testInfo</span>.<span class="text-sky-400">attach</span>(<span class="text-emerald-300">'a11y-scan'</span>, &#123;
        <span class="text-slate-200">body</span><span class="text-slate-400">:</span> <span class="text-amber-300">JSON</span>.<span class="text-sky-400">stringify</span>(<span class="text-sky-300">results</span>.<span class="text-slate-200">violations</span>, <span class="text-purple-400">null</span>, <span class="text-orange-300">2</span>),
        <span class="text-slate-200">contentType</span><span class="text-slate-400">:</span> <span class="text-emerald-300">'application/json'</span>,
      &#125;);

<mark class="block -mx-5 px-5 border-l-2 border-emerald-400 bg-emerald-400/10 text-inherit">      <span class="text-sky-400">expect</span>(<span class="text-sky-300">critical</span>.<span class="text-slate-200">length</span>, <span class="text-emerald-300">'WCAG Violations Found'</span>).<span class="text-sky-400">toBe</span>(<span class="text-orange-300">0</span>);</mark>
    &#125;;

    <span class="text-purple-400">await</span> <span class="text-sky-400">use</span>(<span class="text-sky-300">scanner</span>);
  &#125;,
&#125;);</code></pre>
          </div>

          <div class="px-4 py-3 bg-dark-800 border-t border-dark-700 text-[11px] text-slate-400 flex items-center justify-between gap-2">
            <span>Aligned with DHS Section 508 ICT Baseline</span>
            <span class="text-emerald-400 font-semibold shrink-0">VPAT 2.5 ACR Ready</span>
          </div>
        </figure>

        <!-- Procurement Callout Box -->
        <div class="mt-4 p-5 rounded-lg border border-zinc-200 bg-white text-xs text-zinc-600 leading-relaxed">
          <p>
            <strong class="text-zinc-950 font-semibold">Enterprise Procurement Advantage:</strong> We prepare your codebase to score <span class="text-emerald-700 font-mono font-bold">"Supports"</span> across all WCAG 2.1 AA tables in your official Accessibility Conformance Report (VPAT), unblocking enterprise software sales.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-fixture-btn') as HTMLButtonElement | null;
  const copyLabel = document.getElementById('copy-fixture-label');
  const copyStatus = document.getElementById('copy-fixture-status');

  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', async () => {
      const code = copyBtn.dataset.code || '';
      try {
        await navigator.clipboard.writeText(code);
        copyLabel.textContent = 'Copied';
        if (copyStatus) copyStatus.textContent = 'Code snippet copied to clipboard.';
        setTimeout(() => {
          copyLabel.textContent = 'Copy';
          if (copyStatus) copyStatus.textContent = '';
        }, 2000);
      } catch {
        copyLabel.textContent = 'Copy failed';
        setTimeout(() => {
          copyLabel.textContent = 'Copy';
        }, 2000);
      }
    });
  }
</script>
