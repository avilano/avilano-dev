---
---
<section id="standards" class="py-20 bg-dark-900/60 border-b border-dark-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="text-left max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 font-mono text-xs text-brand-400 font-semibold mb-2 uppercase tracking-wider">
        <span>The Regulatory & Engineering Reality</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Why Static PDF Audits & Overlay Widgets Fail
      </h2>
      <p class="mt-4 text-slate-300 text-base leading-relaxed">
        Enterprise procurement teams fail software with overlay widgets, and static 100-page audits expire the second your team pushes a new PR. 
        We build a <strong class="text-white font-semibold">permanent 3-layer automated testing defense</strong> wired directly into your GitHub Actions CI.
      </p>
    </div>

    <!-- Asymmetric Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: The 3-Layer Defense Stack -->
      <div class="lg:col-span-6 space-y-4">
        
        <!-- Layer 1 -->
        <div class="p-6 rounded-xl bg-dark-800/60 border border-dark-700/80 hover:border-dark-600 transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">Layer 01</span>
            <span class="text-xs font-mono text-brand-400">@axe-core/playwright</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-1.5">Static DOM & Contrast Verification</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Automated scans checking color contrast (4.5:1), missing form labels, invalid ARIA attributes, and unsemantic DOM nodes on every route transition. Fails CI on critical violations.
          </p>
          <div class="mt-3 text-[11px] font-mono text-slate-400">
            Standards: WCAG 1.1.1, 1.4.3, 4.1.2
          </div>
        </div>

        <!-- Layer 2 -->
        <div class="p-6 rounded-xl bg-dark-800/60 border border-dark-700/80 hover:border-dark-600 transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">Layer 02</span>
            <span class="text-xs font-mono text-brand-400">Playwright Keyboard</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-1.5">Deterministic Focus Traps & Tab Order</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Tests sequential Tab navigation, visible focus indicators, skip-to-content links, and modal focus traps that restore focus to the trigger on Escape dismissal (W3C ARIA APG).
          </p>
          <div class="mt-3 text-[11px] font-mono text-slate-400">
            Standards: WCAG 2.1.1, 2.1.2, 2.4.3
          </div>
        </div>

        <!-- Layer 3 -->
        <div class="p-6 rounded-xl bg-dark-800/60 border border-dark-700/80 hover:border-dark-600 transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">Layer 03</span>
            <span class="text-xs font-mono text-brand-400">Guidepup VoiceOver</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-1.5">Native Screen Reader Spoken Audio</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Drives native macOS VoiceOver programmatically to assert what visually impaired users actually hear. Verifies dynamic <code class="text-xs bg-dark-900 px-1 py-0.5 rounded text-emerald-300">aria-live</code> cart updates, notifications, and form error states.
          </p>
          <div class="mt-3 text-[11px] font-mono text-slate-400">
            Standards: WCAG 4.1.3, US Section 508
          </div>
        </div>

      </div>

      <!-- Right Column: Actual Code Implementation Snippet (Using is:raw to prevent JSX interpretation) -->
      <div class="lg:col-span-6">
        <div class="rounded-xl border border-dark-700 bg-dark-900 shadow-xl overflow-hidden font-mono text-xs">
          
          <div class="px-4 py-3 bg-dark-800 border-b border-dark-700 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
              <span class="ml-2 text-slate-300 text-[11px] font-mono">src/fixtures/base.fixture.ts</span>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-sky-950/80 text-sky-400 border border-sky-800/60">TypeScript</span>
          </div>

          <div class="p-5 overflow-x-auto bg-[#070a13] font-mono text-[12px] leading-relaxed select-text">
            <pre class="font-mono"><code><span class="text-slate-500 italic">// Automated WCAG 2.1 AA fixture wired into CI</span>
<span class="text-purple-400">export const</span> <span class="text-sky-300">test</span> <span class="text-slate-400">=</span> <span class="text-slate-200">base</span>.<span class="text-sky-400">extend</span>&lt;<span class="text-amber-300">CustomFixtures</span>&gt;(&#123;
  <span class="text-sky-300">checkA11y</span><span class="text-slate-400">:</span> <span class="text-purple-400">async</span> (&#123; <span class="text-orange-300">page</span> &#125;, <span class="text-orange-300">use</span>, <span class="text-orange-300">testInfo</span>) <span class="text-purple-400">=&gt;</span> &#123;
    <span class="text-purple-400">const</span> <span class="text-sky-300">scanner</span> <span class="text-slate-400">=</span> <span class="text-purple-400">async</span> (<span class="text-orange-300">options</span> <span class="text-slate-400">=</span> &#123;&#125;) <span class="text-purple-400">=&gt;</span> &#123;
      <span class="text-purple-400">const</span> <span class="text-sky-300">builder</span> <span class="text-slate-400">=</span> <span class="text-purple-400">new</span> <span class="text-amber-300">AxeBuilder</span>(&#123; <span class="text-slate-200">page</span> &#125;)
        .<span class="text-sky-400">withTags</span>([<span class="text-emerald-300">'wcag2a'</span>, <span class="text-emerald-300">'wcag2aa'</span>, <span class="text-emerald-300">'wcag21aa'</span>]);

      <span class="text-purple-400">const</span> <span class="text-sky-300">results</span> <span class="text-slate-400">=</span> <span class="text-purple-400">await</span> <span class="text-sky-300">builder</span>.<span class="text-sky-400">analyze</span>();
      <span class="text-purple-400">const</span> <span class="text-sky-300">critical</span> <span class="text-slate-400">=</span> <span class="text-sky-300">results</span>.<span class="text-slate-200">violations</span>.<span class="text-sky-400">filter</span>(
        (<span class="text-orange-300">v</span>) <span class="text-purple-400">=&gt;</span> [<span class="text-emerald-300">'critical'</span>, <span class="text-emerald-300">'serious'</span>].<span class="text-sky-400">includes</span>(<span class="text-orange-300">v</span>.<span class="text-slate-200">impact</span>)
      );

      <span class="text-slate-500 italic">// Attach full audit artifact to Playwright report</span>
      <span class="text-purple-400">await</span> <span class="text-orange-300">testInfo</span>.<span class="text-sky-400">attach</span>(<span class="text-emerald-300">'a11y-scan'</span>, &#123;
        <span class="text-slate-200">body</span><span class="text-slate-400">:</span> <span class="text-amber-300">JSON</span>.<span class="text-sky-400">stringify</span>(<span class="text-sky-300">results</span>.<span class="text-slate-200">violations</span>, <span class="text-purple-400">null</span>, <span class="text-orange-300">2</span>),
        <span class="text-slate-200">contentType</span><span class="text-slate-400">:</span> <span class="text-emerald-300">'application/json'</span>,
      &#125;);

      <span class="text-sky-400">expect</span>(<span class="text-sky-300">critical</span>.<span class="text-slate-200">length</span>, <span class="text-emerald-300">'WCAG Violations Found'</span>).<span class="text-sky-400">toBe</span>(<span class="text-orange-300">0</span>);
    &#125;;

    <span class="text-purple-400">await</span> <span class="text-sky-400">use</span>(<span class="text-sky-300">scanner</span>);
  &#125;,
&#125;);</code></pre>
          </div>

          <div class="px-4 py-3 bg-dark-800/80 border-t border-dark-700 text-[11px] text-slate-400 flex items-center justify-between">
            <span>Aligned with DHS Section 508 ICT Baseline</span>
            <span class="text-emerald-400">VPAT 2.5 ACR Ready</span>
          </div>

        </div>

        <!-- Procurement Callout Box -->
        <div class="mt-4 p-5 rounded-xl border border-dark-700 bg-dark-800/40 text-xs text-slate-300 leading-relaxed">
          <p><strong class="text-white font-semibold">Enterprise Procurement Advantage:</strong> We prepare your codebase to score <span class="text-emerald-300 font-mono font-bold">"Supports"</span> across all WCAG 2.1 AA tables in your official Accessibility Conformance Report (VPAT), unblocking enterprise software sales.</p>
        </div>
      </div>

    </div>

  </div>
</section>
