---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, any>;
}

const {
  title = "avilano | Senior SDET and AI Quality Engineer | Playwright Architecture & WCAG 2.1 AA",
  description = "Partner with an independent Senior SDET and AI Quality Engineer. Flake-resilient Playwright test systems, US ADA Title II / HHS 504 compliance, and async engineering retainers.",
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://avilano.dev');

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://avilano.dev/#person",
  "name": "Alberto E. Vilano Reyna",
  "jobTitle": "Senior SDET and AI Quality Engineer",
  "url": "https://avilano.dev",
  "image": "https://avilano.dev/og-image.png",
  "sameAs": [
    "https://github.com/avilano",
    "https://linkedin.com/in/avilano"
  ],
  "knowsAbout": [
    "Playwright Test Automation",
    "AI Systems Quality & Model Evaluation",
    "WCAG 2.1 AA Accessibility",
    "Continuous Integration & GitHub Actions",
    "TypeScript",
    "Distributed Systems Reliability",
    "Page Object Model Architecture"
  ],
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "The University of Texas Rio Grande Valley"
  }
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://avilano.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://avilano.dev/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Schema.org Person & Identity Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <!-- Progressive enhancement detection -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <!-- WCAG 2.4.1 Bypass Block / Skip to content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand-500 focus:text-white focus:rounded-md focus:shadow-lg"
    >
      Skip to main content
    </a>

    <slot />
    <Analytics />

    <!-- Universal Cross-Browser Viewport Motion (Zero-dependency Progressive Enhancement) -->
    <script is:inline>
      (function() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.08,
          rootMargin: '0px 0px -40px 0px'
        });

        const init = () => {
          document.querySelectorAll('.scroll-reveal').forEach((el) => {
            observer.observe(el);
          });
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
