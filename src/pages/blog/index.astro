---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const blogBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://avilano.dev"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Architecture Notes",
      "item": "https://avilano.dev/blog"
    }
  ]
};
---

<Layout
  title="Architecture Notes & Case Studies | avilano.dev"
  description="Technical playbooks on Playwright test architecture, automated WCAG 2.1 AA accessibility, and flake-resilient CI systems by Alberto E. Vilano Reyna."
  schema={blogBreadcrumbs}
>
  <Header />

  <main id="main-content" class="flex-grow py-16 md:py-24 max-w-5xl mx-auto px-4 sm:px-6 w-full">
    <div class="mb-14">
      <nav aria-label="Breadcrumbs" class="mb-6 font-mono text-xs text-slate-400">
        <ol class="flex items-center gap-2">
          <li>
            <a href="/" class="hover:text-brand-400 transition-colors">Home</a>
          </li>
          <li class="text-slate-600">/</li>
          <li class="text-slate-300 font-medium" aria-current="page">Architecture Notes</li>
        </ol>
      </nav>
      <div class="inline-flex items-center gap-2 font-mono text-xs text-brand-400 font-semibold mb-2 uppercase tracking-wider block">
        <span>Engineering Notes</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Architecture Notes & Case Studies
      </h1>
      <p class="mt-4 text-slate-300 text-base max-w-2xl leading-relaxed">
        Deep dives on automated test infrastructure, eliminating flaky CI pipelines, and enforcing legally binding WCAG 2.1 AA accessibility standards in production.
      </p>
    </div>

    <!-- Articles List -->
    <div class="space-y-6">
      {posts.map((post) => (
        <article class="p-6 sm:p-8 rounded-2xl border border-dark-700 bg-dark-800/40 hover:bg-dark-800/70 hover:border-dark-600 transition-all group">
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-slate-400 mb-3">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              })}
            </time>
            <span>•</span>
            <span>{post.data.readTime}</span>
            <span>•</span>
            <div class="flex gap-2">
              {post.data.tags.map((tag) => (
                <span class="px-2 py-0.5 rounded bg-dark-700 text-slate-300 text-[11px]">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-brand-300 transition-colors">
            <a href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
          </h2>

          <p class="mt-3 text-sm text-slate-300 leading-relaxed max-w-3xl">
            {post.data.description}
          </p>

          <div class="mt-5">
            <a
              href={`/blog/${post.id}`}
              class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-brand-400 group-hover:text-brand-300"
            >
              <span>Read article</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
