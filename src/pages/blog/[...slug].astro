---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCta from '../../components/ProductCta.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleStructuredData = {
  "@type": "TechArticle",
  "headline": post.data.title,
  "description": post.data.description,
  "url": `https://avilano.dev/blog/${post.id}`,
  "image": "https://avilano.dev/og-image.png",
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.pubDate.toISOString(),
  "proficiencyLevel": "Advanced",
  "keywords": post.data.tags.join(', '),
  "author": {
    "@type": "Person",
    "@id": "https://avilano.dev/#person",
    "name": "Alberto E. Vilano Reyna",
    "url": "https://avilano.dev"
  },
  "publisher": {
    "@type": "Person",
    "@id": "https://avilano.dev/#person",
    "name": "Alberto E. Vilano Reyna",
    "logo": {
      "@type": "ImageObject",
      "url": "https://avilano.dev/og-image.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://avilano.dev/blog/${post.id}`
  }
};

const breadcrumbStructuredData = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://avilano.dev"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Architecture Notes",
      "item": "https://avilano.dev/blog"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.data.title,
      "item": `https://avilano.dev/blog/${post.id}`
    }
  ]
};

const articleGraph = {
  "@context": "https://schema.org",
  "@graph": [articleStructuredData, breadcrumbStructuredData]
};
---

<Layout
  title={`${post.data.title} | avilano.dev`}
  description={post.data.description}
  schema={articleGraph}
>
  <Header />

  <main id="main-content" class="flex-grow py-16 md:py-24 max-w-3xl mx-auto px-4 sm:px-6 w-full">
    <!-- Accessible Breadcrumb Navigation -->
    <nav aria-label="Breadcrumbs" class="mb-8 font-mono text-xs text-slate-400">
      <ol class="flex items-center gap-2 flex-wrap">
        <li>
          <a href="/" class="hover:text-brand-400 transition-colors">Home</a>
        </li>
        <li class="text-slate-600">/</li>
        <li>
          <a href="/blog" class="hover:text-brand-400 transition-colors">Architecture Notes</a>
        </li>
        <li class="text-slate-600">/</li>
        <li class="text-slate-300 truncate max-w-xs sm:max-w-md font-medium" aria-current="page">
          {post.data.title}
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-dark-800">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-slate-400 mb-4">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          })}
        </time>
        <span>•</span>
        <span>{post.data.readTime}</span>
        <span>•</span>
        <div class="flex gap-2">
          {post.data.tags.map((tag) => (
            <span class="px-2 py-0.5 rounded bg-dark-800 text-brand-400 text-[11px] border border-dark-700">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {post.data.title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        {post.data.description}
      </p>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-dark-800/60 text-xs font-mono text-slate-400">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-full bg-brand-500/20 text-brand-300 flex items-center justify-center font-bold">
            AV
          </div>
          <span>By Alberto E. Vilano Reyna • Senior SDET and AI Quality Engineer</span>
        </div>
        {post.data.repoUrl && (
          <a
            href={post.data.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-dark-800 hover:bg-dark-700 text-slate-200 border border-dark-700 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-400"
          >
            <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>{post.data.repoLabel ?? 'View Source on GitHub'}</span>
          </a>
        )}
      </div>
    </header>

    <!-- Post Body with Prose styling -->
    <div class="prose max-w-none">
      <Content />
    </div>

    <ProductCta slug={post.id} tags={post.data.tags} />

    <!-- Bottom CTA Card -->
    <div class="mt-16 p-8 rounded-2xl border border-dark-700 bg-dark-900/90 text-center">
      <h3 class="text-xl font-bold text-white mb-2">Need This Architecture Built in Your Codebase?</h3>
      <p class="text-sm text-slate-300 max-w-lg mx-auto mb-6">
        I partner with SaaS engineering leaders on fixed 21-day sprints and async monthly retainers.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/#services"
          class="w-full sm:w-auto px-6 py-2.5 rounded-lg text-xs font-semibold bg-white text-dark-900 hover:bg-slate-100 transition-colors"
        >
          View Sprints & Retainers
        </a>
        <a
          href="/#book-call"
          class="w-full sm:w-auto px-6 py-2.5 rounded-lg text-xs font-semibold text-slate-200 border border-dark-700 bg-dark-800 hover:bg-dark-700 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-400"
        >
          Book 15-Min Architecture Call
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
