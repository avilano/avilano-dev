---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} | avilano.dev`} description={post.data.description}>
  <Header />

  <article class="flex-grow py-16 md:py-24 max-w-3xl mx-auto px-4 sm:px-6 w-full">
    <!-- Back to blog link -->
    <a href="/blog" class="text-xs font-mono text-slate-400 hover:text-brand-400 transition-colors inline-flex items-center gap-1.5 mb-8">
      <span>← Back to all articles</span>
    </a>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-dark-800">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-slate-400 mb-4">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          })}
        </time>
        <span>•</span>
        <span>{post.data.readTime}</span>
        <span>•</span>
        <div class="flex gap-2">
          {post.data.tags.map((tag) => (
            <span class="px-2 py-0.5 rounded bg-dark-800 text-brand-400 text-[11px] border border-dark-700">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {post.data.title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        {post.data.description}
      </p>

      <div class="mt-6 flex items-center gap-3 pt-6 border-t border-dark-800/60 text-xs font-mono text-slate-400">
        <div class="w-7 h-7 rounded-full bg-brand-500/20 text-brand-300 flex items-center justify-center font-bold">
          AV
        </div>
        <span>By Alberto E. Vilano Reyna (Ex-Pinterest SDET II)</span>
      </div>
    </header>

    <!-- Post Body with Prose styling -->
    <div class="prose prose-invert prose-slate max-w-none prose-headings:font-bold prose-headings:text-white prose-headings:tracking-tight prose-a:text-brand-400 hover:prose-a:text-brand-300 prose-code:text-brand-300 prose-code:font-mono prose-pre:bg-[#070a11] prose-pre:border prose-pre:border-dark-700 leading-relaxed text-slate-300 text-sm sm:text-base">
      <Content />
    </div>

    <!-- Bottom CTA Card -->
    <div class="mt-16 p-8 rounded-2xl border border-dark-700 bg-dark-900/90 text-center">
      <h3 class="text-xl font-bold text-white mb-2">Need This Architecture Built in Your Codebase?</h3>
      <p class="text-sm text-slate-300 max-w-lg mx-auto mb-6">
        I partner with SaaS engineering leaders on fixed 21-day sprints and async monthly retainers.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/#services"
          class="w-full sm:w-auto px-6 py-2.5 rounded-lg text-xs font-semibold bg-white text-dark-900 hover:bg-slate-100 transition-colors"
        >
          View Sprints & Retainers
        </a>
        <a
          href="/#book-call"
          class="w-full sm:w-auto px-6 py-2.5 rounded-lg text-xs font-semibold text-slate-200 border border-dark-700 bg-dark-800 hover:bg-dark-700 transition-colors"
        >
          Book 15-Min Architecture Call
        </a>
      </div>
    </div>
  </article>

  <Footer />
</Layout>
